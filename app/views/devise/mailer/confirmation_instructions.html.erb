<div style="margin:0;padding:32px 16px;background-color:#f7f5f0;font-family:Arial,Helvetica,sans-serif;color:#17324d;">
  <div style="max-width:560px;margin:0 auto;padding:32px;background-color:#ffffff;border:1px solid #dbe3e0;border-radius:16px;">
    <p style="margin:0 0 24px;font-size:14px;font-weight:bold;letter-spacing:1px;">BALLYCLARE MEDICAL</p>
    <h1 style="margin:0 0 16px;font-size:28px;line-height:1.3;">Confirm your email address</h1>
    <p style="font-size:16px;line-height:1.6;">Thank you for creating your patient account. Please confirm your email address to continue.</p>
    <p style="margin:28px 0;">
      <%= link_to "Confirm email address", confirmation_url(@resource, confirmation_token: @token), style: "display:inline-block;padding:14px 24px;border-radius:28px;background-color:#17324d;color:#ffffff;text-decoration:none;font-weight:bold;" %>
    </p>
    <p style="font-size:14px;line-height:1.6;color:#596d79;">Confirming your email does not link your account to a medical record. The practice must verify and approve that separately.</p>
    <p style="font-size:14px;line-height:1.6;color:#596d79;">If you did not request this account, you can ignore this email.</p>
  </div>
</div>
