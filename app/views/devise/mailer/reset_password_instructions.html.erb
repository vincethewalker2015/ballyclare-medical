<% invitation = @resource.invitation_pending_at.present? %>
<div style="background:#f7f6f2;padding:36px 16px;font-family:Arial,Helvetica,sans-serif;color:#19324d;">
  <div style="max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #dce3e0;border-radius:16px;overflow:hidden;">
    <div style="background:#173451;padding:24px 32px;color:#ffffff;">
      <div style="font-size:24px;font-weight:bold;">Ballyclare Medical</div>
      <div style="font-size:12px;letter-spacing:3px;color:#a9e3d8;margin-top:6px;">MEDICAL CENTRE</div>
    </div>
    <div style="padding:32px;">
      <h1 style="font-size:25px;margin:0 0 18px;color:#173451;"><%= invitation ? "Welcome to Ballyclare Medical" : "Reset your password" %></h1>
      <% if invitation %>
        <p style="font-size:16px;line-height:1.6;">Your staff account is ready. Set your password to access Ballyclare Medical.</p>
      <% else %>
        <p style="font-size:16px;line-height:1.6;">We received a request to reset your password.</p>
      <% end %>
      <% url = invitation ? edit_staff_invitation_url(reset_password_token: @token) : edit_password_url(@resource, reset_password_token: @token) %>
      <p style="margin:30px 0;"><%= link_to(invitation ? "Set your password" : "Reset your password", url, style: "display:inline-block;background:#173451;color:#ffffff;text-decoration:none;padding:15px 24px;border-radius:24px;font-weight:bold;") %></p>
      <p style="font-size:14px;line-height:1.6;color:#607483;">If you weren't expecting this email, you can safely ignore it.</p>
    </div>
  </div>
</div>
