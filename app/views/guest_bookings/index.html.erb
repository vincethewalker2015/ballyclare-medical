<% content_for :title, "Book an appointment | Ballyclare Medical" %>

<main class="mx-auto max-w-5xl px-6 py-12">
  <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
    <%= link_to root_path, class: "font-sans text-2xl font-semibold tracking-tight text-medical-navy" do %>
      Ballyclare <span class="text-medical-teal-dark">Medical</span>
    <% end %>
    <%= link_to "Already a patient? Sign in", new_patient_account_session_path,
          class: "text-sm font-semibold text-medical-teal-dark underline underline-offset-4" %>
  </div>

  <section class="rounded-3xl border border-medical-border bg-white p-7 shadow-sm sm:p-10">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-medical-teal-dark">Appointments</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-medical-navy">Book as a guest</h1>
    <p class="mt-4 max-w-2xl leading-7 text-medical-muted">
      Visiting the area or need a one-off consultation? You won't need an account or password.
      Choose a practice, clinician and available time below. Secure guest checkout is coming next.
    </p>

    <div class="mt-8 rounded-2xl border border-medical-border bg-medical-cream p-6">
      <h2 class="text-lg font-semibold text-medical-navy">Practices offering online appointments</h2>
      <% if @practices.any? %>
        <ul class="mt-4 space-y-3">
          <% @practices.each do |practice| %>
            <li>
              <%= link_to practice.name, guest_booking_path(practice_id: practice.id),
                    class: "block rounded-xl border border-medical-border bg-white px-5 py-4 font-medium text-medical-navy transition hover:border-medical-teal hover:bg-medical-teal-soft" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-medical-muted">No online appointments are currently listed. Please check back later.</p>
      <% end %>
    </div>

    <% if @practice %>
      <div class="mt-8 border-t border-medical-border pt-8">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-medical-teal-dark">Selected practice</p>
        <h2 class="mt-2 text-2xl font-semibold text-medical-navy"><%= @practice.name %></h2>
        <%= form_with url: guest_booking_path, method: :get, class: "mt-6 space-y-5" do |form| %>
          <%= form.hidden_field :practice_id, value: @practice.id %>
          <div>
            <%= form.label :clinician_id, "Clinician", class: "mb-2 block text-sm font-semibold text-medical-navy" %>
            <%= form.select :clinician_id,
                  options_from_collection_for_select(@clinicians, :id, :full_name, @clinician&.id),
                  { prompt: "Select a clinician" },
                  class: "w-full rounded-xl border border-medical-border bg-white px-4 py-3 text-medical-ink" %>
          </div>
          <div>
            <%= form.label :date, "Appointment date", class: "mb-2 block text-sm font-semibold text-medical-navy" %>
            <%= form.date_field :date, value: params[:date].presence,
                  min: Time.current.in_time_zone(@practice.timezone).to_date.iso8601,
                  class: "rounded-xl border border-medical-border bg-white px-4 py-3 text-medical-ink" %>
          </div>
          <%= form.submit "Find available times",
                class: "cursor-pointer rounded-xl bg-medical-navy px-6 py-3 font-semibold text-white transition hover:bg-medical-navy-deep" %>
        <% end %>
        <% if @clinicians.empty? %>
          <p class="mt-6 text-sm text-medical-muted">There are no clinicians with online availability at this practice.</p>
        <% elsif @clinician %>
          <h3 class="mt-8 text-lg font-semibold text-medical-navy">Available appointments</h3>
          <% if @slots.any? %>
            <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              <% @slots.each do |slot| %>
                <% starts_at = slot.starts_at.in_time_zone(@practice.timezone) %>
                <%= link_to new_guest_booking_path(appointment_slot_id: slot.id), class: "block rounded-xl border border-medical-border bg-medical-cream px-5 py-4 transition hover:border-medical-teal hover:bg-medical-teal-soft" do %>
                  <p class="font-semibold text-medical-navy"><%= starts_at.strftime("%A, %d %B") %></p>
                  <p class="mt-1 text-sm text-medical-muted"><%= starts_at.strftime("%H:%M") %></p>
                  <p class="mt-3 text-sm font-semibold text-medical-teal-dark">Enter your details</p>
                <% end %>
              <% end %>
            </div>
            <p class="mt-4 text-sm text-medical-muted">Selecting a time lets you enter your details. Your time is not reserved until checkout is available.</p>
          <% else %>
            <p class="mt-3 text-sm text-medical-muted">No times available for this selection. Try another date or clinician.</p>
          <% end %>
          <% if @consultation_fee %>
            <p class="mt-6 text-sm font-semibold text-medical-navy">
              Consultation fee:
              <%= number_to_currency(@consultation_fee.amount_cents / 100.0,
                    unit: @consultation_fee.currency == "GBP" ? "£" : "#{@consultation_fee.currency} ") %>
            </p>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <p class="mt-6 text-sm text-medical-muted">
      This is not an emergency service. For a life-threatening emergency, call 999.
    </p>
  </section>
</main>
