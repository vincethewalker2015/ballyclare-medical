<% content_for :title, "Your details | Ballyclare Medical" %>
<main class="mx-auto max-w-3xl px-6 py-12">
  <%= link_to "← Back to appointments", guest_booking_path(practice_id: @slot.practice_id, clinician_id: @slot.clinician_id),
        class: "text-sm font-semibold text-medical-teal-dark hover:underline" %>
  <section class="mt-8 rounded-3xl border border-medical-border bg-white p-7 shadow-sm sm:p-10">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-medical-teal-dark">Guest appointment</p>
    <h1 class="mt-3 text-3xl font-semibold text-medical-navy">Your details</h1>
    <p class="mt-3 text-medical-muted"><%= @slot.clinician.full_name %> · <%= @slot.starts_at.in_time_zone(@slot.practice.timezone).strftime("%A %-d %B %Y, %H:%M") %></p>
    <p class="mt-2 text-sm text-medical-muted">No account required. This time is not yet reserved or confirmed.</p>
    <% if @guest_booking.errors.any? %>
      <div role="alert" class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
        <%= @guest_booking.errors.full_messages.to_sentence %>
      </div>
    <% end %>
    <%= form_with model: @guest_booking, url: guest_booking_details_path, class: "mt-8 space-y-5" do |form| %>
      <%= form.hidden_field :appointment_slot_id %>
      <% [[:first_name, "First name"], [:last_name, "Last name"], [:email, "Email address"], [:phone, "Telephone number"]].each do |field, label| %>
        <div>
          <%= form.label field, label, class: "mb-2 block text-sm font-semibold text-medical-navy" %>
          <%= form.text_field field, required: true, autocomplete: field == :email ? "email" : "on",
                class: "w-full rounded-xl border border-medical-border bg-white px-4 py-3 text-medical-ink" %>
        </div>
      <% end %>
      <div>
        <%= form.label :date_of_birth, "Date of birth", class: "mb-2 block text-sm font-semibold text-medical-navy" %>
        <%= form.date_field :date_of_birth, required: true, max: Date.current.iso8601,
              class: "rounded-xl border border-medical-border bg-white px-4 py-3 text-medical-ink" %>
      </div>
      <div>
        <%= form.label :consultation_reason, "Reason for consultation", class: "mb-2 block text-sm font-semibold text-medical-navy" %>
        <%= form.text_area :consultation_reason, rows: 3, required: true,
              class: "w-full rounded-xl border border-medical-border bg-white px-4 py-3 text-medical-ink" %>
        <p class="mt-2 text-xs text-medical-muted">Please do not use this form for emergencies.</p>
      </div>
      <%= form.submit "Review details", class: "cursor-pointer rounded-xl bg-medical-navy px-6 py-3 font-semibold text-white hover:bg-medical-navy-deep" %>
    <% end %>
  </section>
</main>
