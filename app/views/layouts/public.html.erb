<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Ballyclare Medical | Care centred on you" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Welcome to Ballyclare Medical. Learn about our approach to care and how to contact the practice.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="bg-medical-cream text-medical-ink antialiased">
    <%= yield %>
  </body>
</html>
