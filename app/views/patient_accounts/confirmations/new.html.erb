<% content_for :title, "Confirm your email | Ballyclare Medical" %>

<main class="mx-auto max-w-lg px-6 py-16">
  <h1 class="text-3xl font-semibold text-medical-navy">Resend confirmation email</h1>
  <p class="mt-3 text-medical-muted">Enter your email address to request another confirmation link.</p>
  <div class="mt-8 rounded-2xl border border-medical-border bg-white p-8 shadow-sm">
    <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div>
        <%= f.label :email, class: "block font-semibold text-medical-navy" %>
        <%= f.email_field :email, required: true, autocomplete: "email", class: "mt-2 w-full rounded-xl border border-medical-border px-4 py-3" %>
      </div>
      <%= f.submit "Resend confirmation email", class: "w-full cursor-pointer rounded-full bg-medical-navy px-6 py-3 font-semibold text-white" %>
    <% end %>
  </div>
  <p class="mt-6"><%= link_to "Back to patient sign in", new_patient_account_session_path, class: "font-semibold text-medical-teal-dark" %></p>
</main>
