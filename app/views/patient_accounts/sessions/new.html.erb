<% content_for :title, "Patient sign in | Ballyclare Medical" %>

<main class="mx-auto max-w-lg px-6 py-16">
  <h1 class="text-3xl font-semibold text-medical-navy">Patient sign in</h1>
  <p class="mt-3 text-medical-muted">Sign in to your patient account after confirming your email.</p>
  <div class="mt-8 rounded-2xl border border-medical-border bg-white p-8 shadow-sm">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
      <div>
        <%= f.label :email, class: "block font-semibold text-medical-navy" %>
        <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "mt-2 w-full rounded-xl border border-medical-border px-4 py-3" %>
      </div>
      <div>
        <%= f.label :password, class: "block font-semibold text-medical-navy" %>
        <%= f.password_field :password, required: true, autocomplete: "current-password", class: "mt-2 w-full rounded-xl border border-medical-border px-4 py-3" %>
      </div>
      <%= f.submit "Sign in", class: "w-full cursor-pointer rounded-full bg-medical-navy px-6 py-3 font-semibold text-white" %>
    <% end %>
  </div>
  <div class="mt-6 flex flex-wrap justify-between gap-3 text-sm">
    <%= link_to "Create an account", new_patient_account_registration_path, class: "font-semibold text-medical-teal-dark" %>
    <%= link_to "Forgot password?", new_patient_account_password_path, class: "font-semibold text-medical-teal-dark" %>
    <%= link_to "Resend confirmation email", new_patient_account_confirmation_path, class: "font-semibold text-medical-teal-dark" %>
  </div>
</main>
