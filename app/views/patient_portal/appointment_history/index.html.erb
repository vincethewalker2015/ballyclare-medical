<% content_for :title, "Appointment history | Ballyclare Medical" %>
<main class="mx-auto max-w-5xl px-6 py-10 lg:py-12">\n  <%= turbo_stream_from @patient, :appointment_refunds %>
  <header class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-medical-teal">Patient portal · <%= @patient.first_name %> <%= @patient.last_name %></p>
    <h1 class="mt-3 text-3xl font-semibold text-medical-navy">Your appointment history</h1>
    <p class="mt-2 text-medical-muted">Upcoming, past and cancelled appointments. Dates and times use your practice's local timezone.</p>
    <%= link_to "Back to patient portal", patient_portal_path, class: "mt-4 inline-block text-sm font-semibold text-medical-teal underline" %>
  </header>

  <% { "Upcoming appointments" => @upcoming_appointments, "Past and cancelled appointments" => @past_appointments }.each do |heading, appointments| %>
    <section class="mb-8 rounded-2xl border border-medical-border bg-white p-6 shadow-sm" aria-label="<%= heading %>">
      <h2 class="text-xl font-semibold text-medical-navy"><%= heading %></h2>
      <% if appointments.empty? %>
        <p class="mt-4 text-sm text-medical-muted">No appointments to display.</p>
      <% else %>
        <ul class="mt-4 divide-y divide-medical-border">
          <% appointments.each do |appointment| %>
            <% local_start = appointment.appointment_slot.starts_at.in_time_zone(@practice.timezone) %>
            <li class="flex flex-wrap items-center justify-between gap-4 py-4">
              <%= turbo_stream_from appointment if appointment.status == "cancelled" %>
              <div>
                <p class="font-semibold text-medical-navy"><%= local_start.strftime("%A %-d %B %Y, %-I:%M %p") %></p>
                <p class="mt-1 text-sm text-medical-muted"><%= appointment.clinician.full_name %></p>
              </div>
              <div class="flex flex-col items-end gap-2">
                <span class="rounded-full bg-medical-cream px-3 py-1 text-sm font-medium text-medical-navy"><%= appointment.status.humanize %></span>
                <% if appointment.status == "cancelled" %>
                  <% successful_payments = appointment.payments.select { |payment| payment.status.in?(%w[succeeded requires_refund]) } %>
                  <% refunds = successful_payments.flat_map(&:refunds) %>
                  <% paid_cents = successful_payments.sum(&:amount_cents) %>
                  <% refunded_cents = refunds.select { |refund| refund.status == "succeeded" }.sum(&:amount_cents) %>
                  <% if refunds.any? %>
                    <% refund_status = if refunds.any? { |refund| refund.status.in?(%w[pending processing]) }
                      "Refund pending"
                    elsif refunds.any? { |refund| refund.status == "failed" }
                      "Refund failed — contact your practice"
                    elsif paid_cents.positive? && refunded_cents >= paid_cents
                      "Refund completed"
                    elsif refunded_cents.positive?
                      "Partially refunded — contact your practice"
                    elsif refunds.all? { |refund| refund.status == "cancelled" }
                      "Refund cancelled — contact your practice"
                    else
                      "Refund status unavailable — contact your practice"
                    end %>
                    <span class="text-sm font-medium text-medical-muted"><%= refund_status %></span>
                  <% end %>
                <% end %>
                <% if %w[booked confirmed].include?(appointment.status) && appointment.appointment_slot.starts_at >= 24.hours.from_now %>
                  <%= link_to "Reschedule", edit_patient_portal_appointment_reschedule_path(appointment), class: "inline-flex items-center justify-center rounded-xl border border-medical-border bg-white px-4 py-2 text-sm font-semibold text-medical-navy shadow-sm hover:border-medical-teal hover:text-medical-teal" %>
                  <%= button_to "Cancel appointment", patient_portal_cancel_appointment_path(appointment), method: :patch,
                    form: { data: { turbo_confirm: "Cancel this appointment? Any successful payments will be automatically refunded." } },
                    class: "inline-flex items-center justify-center rounded-xl border border-red-300 bg-white px-4 py-2 text-sm font-semibold text-red-700 shadow-sm hover:bg-red-50" %>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>
</main>
