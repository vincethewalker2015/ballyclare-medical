<% content_for :title, "Appointment reservation | Ballyclare Medical" %>
<main class="mx-auto max-w-5xl px-6 py-10 lg:py-12">
  <div class="mb-8">
    <%= link_to "← Back to appointment search", patient_portal_appointments_path, class: "text-sm font-semibold text-medical-teal hover:underline" %>
    <p class="mt-8 text-xs font-semibold uppercase tracking-[0.2em] text-medical-teal">Patient portal · Appointments</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-medical-navy sm:text-4xl">Your appointment selection</h1>
    <p class="mt-3 text-medical-muted">Review your selected time before continuing to secure payment.</p>
  </div>

  <% if @hold.expired? %>
    <section class="rounded-2xl border border-amber-200 bg-white p-7 shadow-sm sm:p-8">
      <span class="inline-flex rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800">Reservation expired</span>
      <h2 class="mt-5 text-xl font-semibold text-medical-navy">This appointment time is no longer held</h2>
      <p class="mt-2 text-medical-muted">Please select another available appointment time.</p>
      <%= link_to "Find another appointment", patient_portal_appointments_path, class: "mt-6 inline-block rounded-xl bg-medical-navy px-6 py-3 text-sm font-semibold text-white hover:opacity-90" %>
    </section>
  <% else %>
    <% slot = @hold.appointment_slot %>
    <% starts_at = slot.starts_at.in_time_zone(slot.practice.timezone) %>
    <% expires_at = @hold.expires_at.in_time_zone(slot.practice.timezone) %>
    <section class="overflow-hidden rounded-2xl border border-medical-border bg-white shadow-sm" aria-labelledby="reservation-heading">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-medical-border bg-sky-50/70 px-6 py-5 sm:px-8">
        <h2 id="reservation-heading" class="text-lg font-semibold text-medical-navy">Appointment summary</h2>
        <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-900">Temporarily reserved</span>
      </div>
      <div class="grid gap-6 p-6 sm:grid-cols-2 sm:p-8">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-medical-muted">Appointment date</p>
          <p class="mt-2 text-xl font-semibold text-medical-navy"><%= starts_at.strftime("%A %-d %B %Y") %></p>
          <p class="mt-2 text-medical-navy"><%= starts_at.strftime("%-I:%M %p") %></p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-medical-muted">Your clinician</p>
          <p class="mt-2 text-xl font-semibold text-medical-navy"><%= slot.clinician.full_name %></p>
          <p class="mt-2 text-sm text-medical-muted">Ballyclare Medical</p>
        </div>
      </div>
      <div class="mx-6 rounded-xl border border-medical-teal/30 bg-medical-teal-soft p-5 sm:mx-8">
        <p class="text-sm font-semibold text-medical-navy">Your time is reserved until <%= expires_at.strftime("%-I:%M %p") %></p>
        <p class="mt-2 text-sm leading-6 text-medical-muted">Your appointment is not booked yet. It will be confirmed only after successful payment.</p>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-4 px-6 py-7 sm:px-8">
        <%= link_to "Choose a different time", patient_portal_appointments_path, class: "text-sm font-semibold text-medical-teal hover:underline" %>
        <%= button_to "Continue to secure payment", patient_portal_appointment_hold_payment_path(@hold), class: "cursor-pointer rounded-xl bg-medical-navy px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:opacity-90", data: { turbo: false } %>
      </div>
    </section>
  <% end %>
</main>
