<% content_for :title, "Pay for appointment | Ballyclare Medical" %>
<main class="mx-auto max-w-3xl px-6 py-12">
  <h1 class="text-3xl font-semibold text-medical-navy">Pay for your appointment</h1>
  <p class="mt-3 text-medical-muted">Your appointment is confirmed only after successful payment.</p>
  <%= link_to "← Back to patient portal", patient_portal_path, class: "mt-5 inline-block text-sm font-semibold text-medical-teal hover:underline" %>
  <div class="mt-8 rounded-2xl border border-medical-border bg-white p-8"
       data-controller="stripe-payment"
       data-stripe-payment-expires-at-value="<%= @hold.expires_at.iso8601(3) %>"
       data-stripe-payment-publishable-key-value="<%= ENV.fetch("STRIPE_PUBLISHABLE_KEY") %>"
       data-stripe-payment-client-secret-value="<%= @client_secret %>"
       data-return-url="<%= patient_portal_payment_url(@payment) %>">
    <p class="mb-6 text-xl font-semibold"><%= @payment.currency %> <%= number_with_precision(@payment.amount_cents / 100.0, precision: 2) %></p>
    <p class="mb-2 text-sm font-semibold text-medical-navy">Your reservation expires at <%= @hold.expires_at.in_time_zone(@hold.appointment_slot.practice.timezone).strftime("%-I:%M %p") %>.</p>
    <p class="mb-5 text-sm text-medical-muted" data-stripe-payment-target="countdown" role="status" aria-live="polite">Complete payment before this deadline to keep your selected appointment.</p>
    <div class="hidden rounded-xl border border-amber-200 bg-amber-50 p-5" data-stripe-payment-target="expiredNotice" role="alert">
      <p class="font-semibold text-medical-navy">This reservation has expired</p>
      <p class="mt-2 text-sm text-medical-muted">No payment can be submitted for this reservation. Please choose a new appointment time.</p>
      <%= link_to "Find another appointment", patient_portal_appointments_path, class: "mt-4 inline-block rounded-xl bg-medical-navy px-5 py-3 text-sm font-semibold text-white" %>
    </div>
    <form data-stripe-payment-target="form">
      <div data-stripe-payment-target="element"></div>
      <div class="mt-4 hidden text-red-700" data-stripe-payment-target="error"></div>
      <button type="submit" data-stripe-payment-target="submit" data-label="Pay securely" class="mt-6 rounded-full bg-medical-navy px-6 py-3 font-semibold text-white">Pay securely</button>
    </form>
  </div>
</main>
