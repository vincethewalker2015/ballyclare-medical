<% content_for :title, "Payment status | Ballyclare Medical" %>
<main class="mx-auto max-w-5xl px-6 py-10 lg:py-12">
  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-medical-teal">Patient portal · Payments</p>
  <h1 class="mt-3 text-3xl font-semibold tracking-tight text-medical-navy sm:text-4xl">Appointment payment status</h1>
  <p class="mt-3 text-medical-muted">Your appointment and payment information.</p>

  <% booked = @payment.appointment.present? && @payment.status == "succeeded" %>
  <% refund_required = @payment.status == "requires_refund" %>
  <% processing = @payment.status.in?(%w[pending processing]) %>
  <section class="mt-8 overflow-hidden rounded-2xl border border-medical-border bg-white shadow-sm" aria-labelledby="payment-result-heading">
    <div class="border-b border-medical-border bg-sky-50/70 px-6 py-6 sm:px-8">
      <% if booked %>
        <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800">Payment successful</span>
        <h2 id="payment-result-heading" class="mt-4 text-2xl font-semibold text-medical-navy">Your appointment is booked</h2>
        <p class="mt-2 text-medical-muted">Your payment succeeded and your appointment is confirmed.</p>
      <% elsif refund_required %>
        <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-900">Action required</span>
        <h2 id="payment-result-heading" class="mt-4 text-2xl font-semibold text-medical-navy">We couldn't complete your booking</h2>
        <p class="mt-2 text-medical-muted">Payment was received, but the appointment could not be booked. Please contact the practice about a refund.</p>
      <% elsif processing %>
        <span class="rounded-full bg-sky-100 px-3 py-1 text-xs font-semibold text-sky-900">Processing</span>
        <h2 id="payment-result-heading" class="mt-4 text-2xl font-semibold text-medical-navy">Your payment is being processed</h2>
        <p class="mt-2 text-medical-muted">Your appointment is not confirmed yet. Please check back shortly.</p>
      <% else %>
        <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-900">Payment not completed</span>
        <h2 id="payment-result-heading" class="mt-4 text-2xl font-semibold text-medical-navy">Your appointment has not been booked</h2>
        <p class="mt-2 text-medical-muted">Payment was not completed. You can search for another available appointment.</p>
      <% end %>
    </div>
    <div class="p-6 sm:p-8">
      <% if booked %>
        <% appointment = @payment.appointment %>
        <% starts_at = appointment.appointment_slot.starts_at.in_time_zone(appointment.practice.timezone) %>
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-medical-muted">Appointment</p>
            <p class="mt-2 text-lg font-semibold text-medical-navy"><%= starts_at.strftime("%A %-d %B %Y") %></p>
            <p class="mt-1 text-medical-muted"><%= starts_at.strftime("%-I:%M %p") %></p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-medical-muted">Clinician</p>
            <p class="mt-2 text-lg font-semibold text-medical-navy"><%= appointment.clinician.full_name %></p>
            <p class="mt-1 text-sm text-medical-muted">Booking confirmed</p>
          </div>
        </div>
        <div class="mt-7 rounded-xl bg-medical-teal-soft p-5">
          <p class="text-sm font-semibold text-medical-navy">Payment received</p>
          <p class="mt-2 text-2xl font-semibold text-medical-navy"><%= number_to_currency(@payment.amount_cents / 100.0, unit: @payment.currency == "GBP" ? "£" : "#{@payment.currency} ") %></p>
        </div>
      <% end %>
      <div class="mt-7 flex flex-wrap gap-3">
        <%= link_to "Back to patient portal", patient_portal_path, class: "inline-block rounded-xl bg-medical-navy px-6 py-3 text-sm font-semibold text-white hover:opacity-90" %>
        <% unless booked || processing %>
          <%= link_to "Find an appointment", patient_portal_appointments_path, class: "inline-block rounded-xl border border-medical-border px-6 py-3 text-sm font-semibold text-medical-navy hover:bg-medical-cream" %>
        <% end %>
      </div>
    </div>
  </section>
</main>
