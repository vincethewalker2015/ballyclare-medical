<% content_for :title, "Find an appointment | Ballyclare Medical" %>

<div class="mx-auto max-w-5xl px-6 py-12">
  <div class="mb-8 flex flex-wrap items-start justify-between gap-5">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-medical-teal">Appointments</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-medical-navy">Find an appointment</h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-medical-muted">
        Choose your clinician and an available time. We will hold your selection while you complete secure payment.
      </p>
    </div>
    <%= link_to "Back to patient portal", patient_portal_path,
          class: "text-sm font-semibold text-medical-teal hover:text-medical-teal-dark" %>
  </div>

  <section class="rounded-2xl border border-medical-border bg-white p-6 shadow-sm sm:p-8">
    <%= form_with url: patient_portal_appointments_path, method: :get,
          class: "space-y-8" do |form| %>
      <div>
        <%= form.label :clinician_id, "Clinician", class: "mb-2 block text-sm font-semibold text-medical-navy" %>
        <%= render "shared/select_field",
              form: form,
              field: :clinician_id,
              collection: @discovery.clinicians,
              value_method: :id,
              text_method: ->(clinician) { clinician.full_name },
              options: { prompt: "Select a clinician", selected: @discovery.clinician&.id } %>
      </div>

      <div>
        <%= form.label :date, "Appointment date", class: "mb-2 block text-sm font-semibold text-medical-navy" %>
        <%= form.date_field :date,
              value: params[:date].presence || Time.current.in_time_zone(@discovery.practice&.timezone || Time.zone.name).to_date.iso8601,
              min: Time.current.in_time_zone(@discovery.practice&.timezone || Time.zone.name).to_date.iso8601,
              class: "rounded-xl border border-medical-border bg-white px-4 py-3 text-base text-medical-ink" %>
      </div>

      <div class="flex justify-end border-t border-medical-border pt-6">
        <%= form.submit "Find available times",
              class: "cursor-pointer rounded-xl bg-medical-navy px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-medical-navy-deep focus:outline-none focus:ring-2 focus:ring-medical-navy focus:ring-offset-2" %>
      </div>
    <% end %>

    <div class="mt-8 border-t border-medical-border pt-8">
      <h2 class="text-sm font-semibold text-medical-navy">Available appointment</h2>
      <p class="mt-1 text-sm leading-6 text-medical-muted">Choose an available time for the selected clinician.</p>

      <% if @discovery.clinicians.empty? %>
        <div class="mt-4 rounded-xl border border-medical-border bg-medical-cream px-5 py-4 text-sm text-medical-muted">
          There are no clinicians with online availability at the moment.
        </div>
      <% elsif @discovery.clinician.nil? %>
        <div class="mt-4 rounded-xl border border-medical-border bg-medical-cream px-5 py-4 text-sm text-medical-muted">
          Select a clinician to view available appointments.
        </div>
      <% elsif @discovery.slots.any? %>
        <p class="mb-3 mt-5 text-sm text-medical-muted"><%= pluralize(@discovery.slots.size, "available time") %> · Scroll to see more</p>
        <div class="max-h-80 overflow-y-auto overscroll-contain rounded-xl border border-medical-border p-2"
             tabindex="0" aria-label="Available appointment times">
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <% @discovery.slots.each do |slot| %>
              <% local_starts_at = slot.starts_at.in_time_zone(@discovery.practice.timezone) %>
              <%= button_to patient_portal_appointment_holds_path,
                    params: { appointment_slot_id: slot.id },
                    class: "block w-full cursor-pointer rounded-xl border border-medical-border bg-white px-4 py-3 text-left transition hover:border-medical-teal hover:bg-medical-teal-soft focus:outline-none focus:ring-2 focus:ring-medical-teal" do %>
                <span class="block text-sm font-semibold text-medical-navy"><%= local_starts_at.strftime("%A, %d %B") %></span>
                <span class="mt-1 block text-sm text-medical-muted"><%= local_starts_at.strftime("%H:%M") %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="mt-4 rounded-xl border border-medical-border bg-medical-cream px-5 py-4">
          <p class="text-sm font-medium text-medical-navy">No upcoming appointments available</p>
          <p class="mt-1 text-sm text-medical-muted">Try another date or clinician.</p>
        </div>
      <% end %>
    </div>

    <% if @discovery.clinician %>
      <div class="mt-8 rounded-xl border border-medical-border bg-medical-cream px-5 py-4">
        <p class="text-sm font-semibold text-medical-navy">Consultation fee</p>
        <p class="mt-1 text-sm text-medical-muted">The consultation fee is payable securely before your appointment is confirmed.</p>
        <% if @consultation_fee %>
          <p class="mt-2 text-sm font-semibold text-medical-navy">
            <%= number_to_currency(@consultation_fee.amount_cents / 100.0,
                  unit: @consultation_fee.currency == "GBP" ? "£" : "#{@consultation_fee.currency} ") %>
          </p>
        <% else %>
          <p class="mt-2 text-sm font-semibold text-medical-navy">Consultation fee not configured</p>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
