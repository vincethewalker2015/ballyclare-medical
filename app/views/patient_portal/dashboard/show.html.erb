<% content_for :title, "Patient portal | Ballyclare Medical" %>

<main class="mx-auto max-w-2xl px-6 py-16">
  <h1 class="text-3xl font-semibold text-medical-navy">Patient portal</h1>
  <p class="mt-4 text-medical-muted">Your email address has been confirmed. Your account is not yet linked to a medical record.</p>
  <p class="mt-3 text-medical-muted">Please contact the practice to arrange identity verification. Your medical information will not be available until the practice approves the link.</p>
  <%= button_to "Sign out", destroy_patient_account_session_path, method: :delete, class: "mt-8 rounded-full bg-medical-navy px-6 py-3 font-semibold text-white" %>
</main>
