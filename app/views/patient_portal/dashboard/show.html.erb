<% content_for :title, "Patient portal | Ballyclare Medical" %>

<main class="mx-auto max-w-4xl px-6 py-12">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-semibold text-medical-navy">Your patient portal</h1>
      <p class="mt-2 text-medical-muted">Your appointments and balances in one place.</p>
    </div>
    <%= button_to "Sign out", destroy_patient_account_session_path, method: :delete, class: "rounded-full bg-medical-navy px-6 py-3 font-semibold text-white" %>
  </div>

  <% unless @dashboard.patient %>
    <section class="mt-10 rounded-2xl border border-slate-200 p-6">
      <h2 class="text-xl font-semibold text-medical-navy">Account verification pending</h2>
      <p class="mt-3 text-medical-muted">Your account must be securely linked to a patient record before appointments or balances can be displayed. Please contact your practice to complete the identity check.</p>
    </section>
  <% else %>
    <section class="mt-10 rounded-2xl border border-slate-200 p-6" aria-labelledby="next-appointment-heading">
      <h2 id="next-appointment-heading" class="text-xl font-semibold text-medical-navy">Next appointment</h2>
      <% if @dashboard.next_appointment %>
        <% appointment = @dashboard.next_appointment %>
        <p class="mt-3 text-medical-navy"><strong><%= appointment.appointment_slot.starts_at.in_time_zone(@dashboard.practice.timezone).strftime("%A %-d %B %Y, %-I:%M %p") %></strong></p>
        <p class="mt-2 text-medical-muted">With <%= appointment.clinician.first_name %> <%= appointment.clinician.last_name %> · <%= appointment.status.humanize %></p>
      <% else %>
        <p class="mt-3 text-medical-muted">You have no upcoming appointments.</p>
      <% end %>
    </section>

    <section class="mt-8" aria-labelledby="upcoming-heading">
      <h2 id="upcoming-heading" class="text-xl font-semibold text-medical-navy">Upcoming appointments</h2>
      <% if @dashboard.upcoming_appointments.any? %>
        <ul class="mt-4 space-y-3">
          <% @dashboard.upcoming_appointments.each do |appointment| %>
            <li class="rounded-xl border border-slate-200 p-4">
              <p class="font-semibold text-medical-navy"><%= appointment.appointment_slot.starts_at.in_time_zone(@dashboard.practice.timezone).strftime("%-d %B %Y at %-I:%M %p") %></p>
              <p class="mt-1 text-medical-muted"><%= appointment.clinician.first_name %> <%= appointment.clinician.last_name %> · <%= appointment.status.humanize %></p>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-4 text-medical-muted">There are no upcoming appointments to display.</p>
      <% end %>
    </section>

    <section class="mt-8" aria-labelledby="balances-heading">
      <h2 id="balances-heading" class="text-xl font-semibold text-medical-navy">Outstanding balances</h2>
      <% if @dashboard.outstanding_appointments.any? %>
        <ul class="mt-4 space-y-3">
          <% @dashboard.outstanding_appointments.each do |appointment| %>
            <% balance = @dashboard.balances.fetch(appointment.id) %>
            <li class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 p-4">
              <span class="text-medical-muted">Appointment on <%= appointment.appointment_slot.starts_at.in_time_zone(@dashboard.practice.timezone).strftime("%-d %B %Y") %></span>
              <strong class="text-medical-navy"><%= number_to_currency(balance[:balance_cents] / 100.0, unit: balance[:currency].to_s + " ", format: "%u%n") %></strong>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-4 text-medical-muted">You have no outstanding balances.</p>
      <% end %>
    </section>
  <% end %>
</main>
