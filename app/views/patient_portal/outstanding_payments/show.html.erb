<% content_for :title, "Pay outstanding balance | Ballyclare Medical" %>

<main class="mx-auto max-w-5xl px-6 py-10 lg:py-12">
  <header class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-medical-teal">Patient portal · Payments</p>
    <h1 class="mt-3 text-3xl font-semibold text-medical-navy">Pay outstanding balance</h1>
    <p class="mt-2 text-medical-muted">Review the outstanding charges for your appointment before continuing to secure payment.</p>
    <%= link_to "Back to patient portal", patient_portal_path,
      class: "mt-4 inline-block text-sm font-semibold text-medical-teal underline hover:text-medical-teal-dark" %>
  </header>

  <section class="rounded-2xl border border-medical-border bg-white p-6 shadow-sm sm:p-8" aria-labelledby="outstanding-payment-heading">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 id="outstanding-payment-heading" class="text-xl font-semibold text-medical-navy">Appointment balance</h2>
        <p class="mt-2 text-sm text-medical-muted">
          Appointment: <%= @appointment.appointment_slot.starts_at.in_time_zone(@link.practice.timezone).strftime("%-d %B %Y") %>
        </p>
      </div>
      <span class="rounded-full bg-medical-cream px-3 py-1 text-sm font-medium text-medical-navy">Outstanding payment</span>
    </div>

    <div class="mt-6 border-t border-medical-border pt-6">
      <p class="text-sm font-medium text-medical-muted">Amount outstanding</p>
      <p class="mt-2 text-3xl font-semibold tracking-tight text-medical-navy">
        <%= number_to_currency(@balance[:balance_cents] / 100.0, unit: @balance[:currency] == "GBP" ? "£" : "#{@balance[:currency]} ") %>
      </p>
    </div>

    <div class="mt-6 border-t border-medical-border pt-6">
      <% if @in_progress %>
        <p class="rounded-xl border border-medical-border bg-medical-cream p-4 text-sm text-medical-muted" role="status">
          A payment is already in progress. Please wait for confirmation or contact the practice.
        </p>
      <% elsif @appointment.status == "cancelled" %>
        <p class="rounded-xl border border-medical-border bg-medical-cream p-4 text-sm text-medical-muted">
          Online payment is unavailable for a cancelled appointment. Contact the practice.
        </p>
      <% elsif @balance[:balance_cents].positive? %>
        <%= button_to "Pay outstanding balance securely", patient_portal_outstanding_payment_path(@appointment),
          method: :post,
          class: "inline-flex w-full cursor-pointer items-center justify-center rounded-full bg-medical-navy px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-medical-navy-deep focus:outline-none focus:ring-2 focus:ring-medical-teal focus:ring-offset-2 sm:w-auto" %>
        <p class="mt-3 text-sm text-medical-muted">You will continue to the secure payment form.</p>
      <% else %>
        <p class="rounded-xl border border-medical-border bg-medical-cream p-4 text-sm text-medical-muted" role="status">
          This appointment has no outstanding balance.
        </p>
      <% end %>
    </div>
  </section>
</main>
