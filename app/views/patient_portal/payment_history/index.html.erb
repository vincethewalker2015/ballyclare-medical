<% content_for :title, "Payment history | Ballyclare Medical" %>
<main class="mx-auto max-w-5xl px-6 py-10 lg:py-12">
  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-medical-teal">Patient portal</p>
  <h1 class="mt-3 text-3xl font-semibold text-medical-navy">Payment history</h1>
  <p class="mt-2 text-medical-muted">Payments and refunds recorded for your appointments. Amounts are shown in their recorded currency.</p>
  <%= link_to "Back to patient portal", patient_portal_path, class: "mt-4 inline-block text-sm font-semibold text-medical-teal underline" %>

  <section class="mt-8 rounded-2xl border border-medical-border bg-white p-6 shadow-sm" aria-label="Payment transactions">
    <% if @payments.empty? %>
      <p class="text-medical-muted">No payment transactions to display.</p>
    <% else %>
      <ul class="divide-y divide-medical-border">
        <% @payments.each do |payment| %>
          <% local_date = payment.created_at.in_time_zone(@practice.timezone) %>
          <% successful_refunds = payment.refunds.select { |refund| refund.status == "succeeded" } %>
          <% amount = number_to_currency(payment.amount_cents / 100.0, unit: payment.currency == "GBP" ? "£" : "#{payment.currency} ") %>
          <li class="flex flex-wrap items-start justify-between gap-4 py-5">
            <div>
              <p class="font-semibold text-medical-navy"><%= local_date.strftime("%-d %B %Y, %-I:%M %p") %></p>
              <p class="mt-1 text-sm text-medical-muted">Payment <%= payment.status.humanize %> · <%= amount %></p>
              <% if payment.appointment %>
                <p class="mt-1 text-sm text-medical-muted">Appointment: <%= payment.appointment.appointment_slot.starts_at.in_time_zone(@practice.timezone).strftime("%-d %B %Y") %></p>
              <% end %>
              <% payment.refunds.sort_by(&:requested_at).each do |refund| %>
                <p class="mt-2 text-sm text-medical-muted">Refund <%= refund.status.humanize.downcase %>: <%= number_to_currency(refund.amount_cents / 100.0, unit: refund.currency == "GBP" ? "£" : "#{refund.currency} ") %></p>
              <% end %>
              <% if successful_refunds.any? %>
                <p class="mt-1 text-sm font-medium text-medical-navy">Net received: <%= number_to_currency((payment.amount_cents - successful_refunds.sum(&:amount_cents)) / 100.0, unit: payment.currency == "GBP" ? "£" : "#{payment.currency} ") %></p>
              <% end %>
            </div>
            <% if payment.status == "succeeded" %>
              <%= link_to "View receipt", patient_portal_payment_receipt_path(payment), class: "text-sm font-semibold text-medical-teal underline" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</main>
