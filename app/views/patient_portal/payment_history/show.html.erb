<% content_for :title, "Payment receipt | Ballyclare Medical" %>
<main class="mx-auto max-w-3xl px-6 py-10 lg:py-12">
  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-medical-teal">Patient portal · Payments</p>
  <h1 class="mt-3 text-3xl font-semibold text-medical-navy">Payment receipt</h1>
  <p class="mt-2 text-medical-muted">Record of a successful payment, including any recorded refunds.</p>
  <section class="mt-8 rounded-2xl border border-medical-border bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-medical-navy"><%= @practice.name %></h2>
    <dl class="mt-5 grid gap-4">
      <div><dt class="text-sm text-medical-muted">Payment reference</dt><dd class="font-semibold text-medical-navy"><%= @payment.id %></dd></div>
      <div><dt class="text-sm text-medical-muted">Payment date</dt><dd class="font-semibold text-medical-navy"><%= (@payment.paid_at || @payment.created_at).in_time_zone(@practice.timezone).strftime("%-d %B %Y, %-I:%M %p") %></dd></div>
      <div><dt class="text-sm text-medical-muted">Status</dt><dd class="font-semibold text-medical-navy"><%= @payment.status.humanize %></dd></div>
      <div><dt class="text-sm text-medical-muted">Amount paid</dt><dd class="font-semibold text-medical-navy"><%= number_to_currency(@payment.amount_cents / 100.0, unit: @payment.currency == "GBP" ? "£" : "#{@payment.currency} ") %></dd></div>
      <% @payment.refunds.sort_by(&:requested_at).each do |refund| %>
        <div><dt class="text-sm text-medical-muted">Refund (<%= refund.status.humanize.downcase %>)</dt><dd class="font-semibold text-medical-navy"><%= number_to_currency(refund.amount_cents / 100.0, unit: refund.currency == "GBP" ? "£" : "#{refund.currency} ") %></dd></div>
      <% end %>
      <div><dt class="text-sm text-medical-muted">Net received after successful refunds</dt><dd class="font-semibold text-medical-navy"><%= number_to_currency((@payment.amount_cents - @successful_refunds.sum(&:amount_cents)) / 100.0, unit: @payment.currency == "GBP" ? "£" : "#{@payment.currency} ") %></dd></div>
    </dl>
  </section>
  <div class="mt-6 flex flex-wrap gap-5">
    <%= link_to "Back to payment history", patient_portal_payment_history_path, class: "font-semibold text-medical-teal underline" %>
    <button type="button" data-controller="print-receipt" data-action="click->print-receipt#print" class="font-semibold text-medical-teal underline">Print receipt</button>
  </div>
</main>
