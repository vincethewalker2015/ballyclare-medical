<% content_for :title, "Edit sign-in details | Ballyclare Medical" %>
<main class="mx-auto max-w-5xl px-6 py-10">
  <header class="mb-8">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-medical-teal">Patient portal</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-medical-navy">Edit sign-in details</h1>
    <p class="mt-2 text-sm leading-6 text-medical-muted">Enter your current password to save changes. Leave the new password blank to keep it unchanged.</p>
  </header>
  <section class="rounded-2xl border border-medical-border bg-white p-6 shadow-sm sm:p-8">
    <%= form_with model: current_patient_account, url: patient_portal_profile_path, method: :patch, class: "space-y-6" do |form| %>
      <% if current_patient_account.errors.any? %>
        <div role="alert" class="rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-800">
          <p class="font-semibold">Unable to update your details:</p>
          <ul class="mt-2 list-disc space-y-1 pl-5"><% current_patient_account.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
        </div>
      <% end %>
      <div>
        <%= form.label :email, "Sign-in email", class: "mb-2 block text-sm font-semibold text-medical-navy" %>
        <%= form.email_field :email, required: true, autocomplete: "email", class: "block w-full rounded-xl border border-medical-border bg-white px-4 py-3 text-base text-medical-ink shadow-sm outline-none transition focus:border-medical-teal focus:ring-4 focus:ring-medical-teal/10" %>
        <p class="mt-2 text-sm text-medical-muted">A change of email address requires confirmation through your new inbox.</p>
      </div>
      <div>
        <%= form.label :password, "New password (optional)", class: "mb-2 block text-sm font-semibold text-medical-navy" %>
        <div class="relative" data-controller="password-visibility">
        <%= form.password_field :password, autocomplete: "new-password", data: { password_visibility_target: "input" }, class: "block w-full rounded-xl border border-medical-border bg-white pl-4 pr-14 py-3 text-base text-medical-ink shadow-sm outline-none transition focus:border-medical-teal focus:ring-4 focus:ring-medical-teal/10" %>
          <button type="button" data-password-visibility-target="button" data-action="password-visibility#toggle" aria-label="Show password" aria-pressed="false" title="Show password" class="absolute inset-y-0 right-0 flex w-12 items-center justify-center rounded-r-xl text-medical-muted hover:text-medical-navy focus:outline-none focus:ring-2 focus:ring-inset focus:ring-medical-teal">
            <svg data-password-visibility-target="showIcon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.1 12a10.9 10.9 0 0 1 19.8 0 10.9 10.9 0 0 1-19.8 0Z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg data-password-visibility-target="hideIcon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 3 18 18"/><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.9 5.2A11 11 0 0 1 12 5c4.8 0 8.7 3 10 7a11.5 11.5 0 0 1-4 5.2"/><path d="M6.2 6.2A11.5 11.5 0 0 0 2 12c1.3 4 5.2 7 10 7a11 11 0 0 0 4.3-.9"/></svg>
          </button>
        </div>
      </div>
      <div>
        <%= form.label :password_confirmation, "Confirm new password", class: "mb-2 block text-sm font-semibold text-medical-navy" %>
        <div class="relative" data-controller="password-visibility">
        <%= form.password_field :password_confirmation, autocomplete: "new-password", data: { password_visibility_target: "input" }, class: "block w-full rounded-xl border border-medical-border bg-white pl-4 pr-14 py-3 text-base text-medical-ink shadow-sm outline-none transition focus:border-medical-teal focus:ring-4 focus:ring-medical-teal/10" %>
          <button type="button" data-password-visibility-target="button" data-action="password-visibility#toggle" aria-label="Show password" aria-pressed="false" title="Show password" class="absolute inset-y-0 right-0 flex w-12 items-center justify-center rounded-r-xl text-medical-muted hover:text-medical-navy focus:outline-none focus:ring-2 focus:ring-inset focus:ring-medical-teal">
            <svg data-password-visibility-target="showIcon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.1 12a10.9 10.9 0 0 1 19.8 0 10.9 10.9 0 0 1-19.8 0Z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg data-password-visibility-target="hideIcon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 3 18 18"/><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.9 5.2A11 11 0 0 1 12 5c4.8 0 8.7 3 10 7a11.5 11.5 0 0 1-4 5.2"/><path d="M6.2 6.2A11.5 11.5 0 0 0 2 12c1.3 4 5.2 7 10 7a11 11 0 0 0 4.3-.9"/></svg>
          </button>
        </div>
      </div>
      <div>
        <%= form.label :current_password, "Current password", class: "mb-2 block text-sm font-semibold text-medical-navy" %>
        <div class="relative" data-controller="password-visibility">
        <%= form.password_field :current_password, required: true, autocomplete: "current-password", data: { password_visibility_target: "input" }, class: "block w-full rounded-xl border border-medical-border bg-white pl-4 pr-14 py-3 text-base text-medical-ink shadow-sm outline-none transition focus:border-medical-teal focus:ring-4 focus:ring-medical-teal/10" %>
          <button type="button" data-password-visibility-target="button" data-action="password-visibility#toggle" aria-label="Show password" aria-pressed="false" title="Show password" class="absolute inset-y-0 right-0 flex w-12 items-center justify-center rounded-r-xl text-medical-muted hover:text-medical-navy focus:outline-none focus:ring-2 focus:ring-inset focus:ring-medical-teal">
            <svg data-password-visibility-target="showIcon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.1 12a10.9 10.9 0 0 1 19.8 0 10.9 10.9 0 0 1-19.8 0Z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg data-password-visibility-target="hideIcon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 3 18 18"/><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.9 5.2A11 11 0 0 1 12 5c4.8 0 8.7 3 10 7a11.5 11.5 0 0 1-4 5.2"/><path d="M6.2 6.2A11.5 11.5 0 0 0 2 12c1.3 4 5.2 7 10 7a11 11 0 0 0 4.3-.9"/></svg>
          </button>
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-4 border-t border-medical-border pt-6">
        <%= link_to "Back to profile", patient_portal_profile_path, class: "text-sm font-semibold text-medical-teal hover:text-medical-teal-dark" %>
        <%= form.submit "Save changes", class: "cursor-pointer rounded-xl bg-medical-navy px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-medical-navy-deep focus:outline-none focus:ring-2 focus:ring-medical-navy focus:ring-offset-2" %>
      </div>
    <% end %>
  </section>
</main>
