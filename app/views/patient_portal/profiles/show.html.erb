<% content_for :title, "Your profile | Ballyclare Medical" %>
<main class="mx-auto max-w-5xl px-6 py-10">
  <header class="mb-8">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-medical-teal">Patient portal</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-medical-navy">Your profile</h1>
    <p class="mt-2 text-sm leading-6 text-medical-muted">Your verified patient details are managed by your practice.</p>
  </header>
  <section class="rounded-2xl border border-medical-border bg-white p-6 shadow-sm sm:p-8">
    <h2 class="text-lg font-semibold text-medical-navy">Patient details</h2>
    <dl class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2">
      <div><dt class="text-sm font-medium text-medical-muted">Name</dt><dd class="mt-1 font-semibold text-medical-navy"><%= @patient.first_name %> <%= @patient.last_name %></dd></div>
      <div><dt class="text-sm font-medium text-medical-muted">Date of birth</dt><dd class="mt-1 font-semibold text-medical-navy"><%= @patient.date_of_birth.strftime("%-d %B %Y") %></dd></div>
      <div><dt class="text-sm font-medium text-medical-muted">Patient number</dt><dd class="mt-1 font-semibold text-medical-navy"><%= @patient.patient_number %></dd></div>
      <div><dt class="text-sm font-medium text-medical-muted">Sign-in email</dt><dd class="mt-1 break-all font-semibold text-medical-navy"><%= current_patient_account.email %></dd></div>
    </dl>
    <p class="mt-8 rounded-xl border border-medical-border bg-medical-cream px-5 py-4 text-sm leading-6 text-medical-muted">To correct your name or date of birth, contact your practice so they can verify the change.</p>
    <div class="mt-6 flex flex-wrap items-center gap-4 border-t border-medical-border pt-6">
      <%= link_to "Edit sign-in details", edit_patient_portal_profile_path, class: "inline-flex items-center rounded-xl bg-medical-navy px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-medical-navy-deep focus:outline-none focus:ring-2 focus:ring-medical-navy focus:ring-offset-2" %>
      <%= link_to "Back to patient portal", patient_portal_path, class: "text-sm font-semibold text-medical-teal hover:text-medical-teal-dark" %>
    </div>
  </section>
</main>
