<% content_for :title, "Patient portal access unavailable | Ballyclare Medical" %>
<main class="mx-auto max-w-5xl px-6 py-10 lg:py-12">
  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-medical-teal">Patient portal</p>
  <section class="mt-8 rounded-2xl border border-medical-border bg-white p-8 shadow-sm">
    <h1 class="text-2xl font-semibold text-medical-navy">Patient portal access unavailable</h1>
    <p class="mt-3 max-w-2xl text-medical-muted">Access to your patient record through the online portal has been disabled or is not yet approved. Your patient account remains active, but appointments and account information cannot currently be displayed. Please contact your practice if you believe this is incorrect or would like to request access again.</p>
    <%= link_to "Back to patient portal", patient_portal_path, class: "mt-6 inline-block font-semibold text-medical-teal underline" %>
  </section>
</main>
