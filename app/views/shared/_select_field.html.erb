<div class="relative">
  <%= form.collection_select(
        field,
        collection,
        value_method,
        text_method,
        options,
        class: "block w-full appearance-none rounded-xl border border-medical-border bg-white px-4 py-3 pr-11 text-base text-medical-ink shadow-sm outline-none transition focus:border-medical-teal focus:ring-4 focus:ring-medical-teal/10"
      ) %>

  <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-medical-muted">
    <svg
      class="h-5 w-5"
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      aria-hidden="true"
    >
      <path
        d="m6 8 4 4 4-4"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </div>
</div>
