<% content_for :title, "Add charge | Ballyclare Medical" %>

<div class="mx-auto max-w-2xl">
  <div class="mb-8">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-medical-teal">
      Appointment
    </p>

    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-medical-navy">
      Add charge
    </h1>

    <p class="mt-2 text-sm leading-6 text-medical-muted">
      Add an additional charge to
      <span class="font-semibold text-medical-ink">
        <%= @appointment.patient.first_name %>
        <%= @appointment.patient.last_name %>
      </span>.
    </p>
  </div>

  <div class="rounded-2xl border border-medical-border bg-white p-8 shadow-sm">
    <% if @error.present? %>
      <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        <%= @error %>
      </div>
    <% end %>

    <%= form_with url: practice_appointment_charge_path(@appointment),
                  method: :post,
                  class: "space-y-6" do |form| %>

      <div>
        <%= form.label :description,
                       "Description",
                       class: "block text-sm font-semibold text-medical-navy" %>

        <%= form.text_field :description,
                            value: params[:description],
                            placeholder: "e.g. Additional procedure",
                            required: true,
                            class: "mt-2 block w-full rounded-xl border border-medical-border bg-white px-4 py-3 text-medical-ink shadow-sm focus:border-medical-teal focus:outline-none focus:ring-2 focus:ring-medical-teal/20" %>

        <p class="mt-2 text-sm text-medical-muted">
          Describe what this additional charge is for.
        </p>
      </div>

      <div>
        <%= form.label :amount,
                       "Amount (#{@appointment.practice.currency})",
                       class: "block text-sm font-semibold text-medical-navy" %>

        <%= form.number_field :amount,
                              value: params[:amount],
                              min: "0.01",
                              step: "0.01",
                              required: true,
                              inputmode: "decimal",
                              class: "mt-2 block w-full rounded-xl border border-medical-border bg-white px-4 py-3 text-medical-ink shadow-sm focus:border-medical-teal focus:outline-none focus:ring-2 focus:ring-medical-teal/20" %>

        <p class="mt-2 text-sm text-medical-muted">
          This will be added to the appointment's outstanding balance.
        </p>
      </div>

      <div class="flex flex-col-reverse gap-3 border-t border-medical-border pt-6 sm:flex-row sm:justify-end">
        <%= link_to "Cancel",
                    practice_appointment_path(@appointment),
                    class: "inline-flex items-center justify-center rounded-xl border border-medical-border bg-white px-5 py-3 text-sm font-semibold text-medical-navy transition hover:bg-medical-cream" %>

        <%= form.submit "Add charge",
                        class: "inline-flex cursor-pointer items-center justify-center rounded-xl bg-medical-navy px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-medical-navy-deep focus:outline-none focus:ring-2 focus:ring-medical-navy focus:ring-offset-2" %>
      </div>
    <% end %>
  </div>
</div>
