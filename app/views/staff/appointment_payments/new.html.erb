<% content_for :title, "Take payment | Ballyclare Medical" %>

<div class="mx-auto max-w-3xl">
  <div class="mb-8">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-medical-teal">
      Payments
    </p>

    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-medical-navy">
      Take payment
    </h1>

    <p class="mt-2 text-sm leading-6 text-medical-muted">
      Record a payment for
      <%= @appointment.patient.first_name %>
      <%= @appointment.patient.last_name %>.
    </p>
  </div>

  <div class="rounded-2xl border border-medical-border bg-white p-8 shadow-sm">
    <div class="mb-8 rounded-xl bg-medical-cream p-5">
      <p class="text-sm font-medium text-medical-muted">
        Outstanding balance
      </p>

      <p class="mt-1 text-2xl font-semibold text-medical-navy">
        <%= @balance[:currency] %>
        <%= number_with_precision(
              @balance[:balance_cents] / 100.0,
              precision: 2
            ) %>
      </p>
    </div>

    <%= form_with url: practice_appointment_payment_path(@appointment),
                  method: :post,
                  data: { turbo: false } do |form| %>

      <div>
        <%= form.label :amount,
                       "Payment amount",
                       class: "mb-2 block text-sm font-semibold text-medical-navy" %>

        <div class="max-w-xs">
          <%= form.number_field :amount,
                                value: format(
                                  "%.2f",
                                  @balance[:balance_cents] / 100.0
                                ),
                                min: "0.01",
                                step: "0.01",
                                class: "block w-full rounded-xl border border-medical-border bg-white px-4 py-3 text-base text-medical-ink shadow-sm outline-none transition focus:border-medical-teal focus:ring-4 focus:ring-medical-teal/10" %>
        </div>

        <p class="mt-2 text-sm text-medical-muted">
          You can take the full balance or enter a smaller amount for a partial payment.
        </p>
      </div>

      <div class="mt-8 flex items-center justify-between border-t border-medical-border pt-6">
        <%= link_to "Cancel",
                    practice_appointment_path(@appointment),
                    class: "text-sm font-semibold text-medical-teal hover:text-medical-teal-dark" %>

        <%= form.submit "Continue to payment",
                        class: "cursor-pointer rounded-xl bg-medical-navy px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-medical-navy-deep focus:outline-none focus:ring-2 focus:ring-medical-navy focus:ring-offset-2" %>
      </div>
    <% end %>
  </div>
</div>
