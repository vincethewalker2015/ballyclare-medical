<section
  id="appointment_charges"
  class="rounded-2xl border border-medical-border bg-white p-8 shadow-sm"
>
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h2 class="text-lg font-semibold text-medical-navy">
        Charges
      </h2>

      <p class="mt-1 text-sm text-medical-muted">
        Charges associated with this appointment.
      </p>
    </div>

    <%= link_to "Add charge",
                new_practice_appointment_charge_path(appointment),
                class: "inline-flex shrink-0 items-center justify-center rounded-xl border border-medical-border bg-white px-4 py-2.5 text-sm font-semibold text-medical-navy shadow-sm transition hover:bg-medical-cream focus:outline-none focus:ring-2 focus:ring-medical-navy focus:ring-offset-2" %>
  </div>

  <% if appointment.appointment_charges.any? %>
    <div class="divide-y divide-medical-border">
      <% appointment.appointment_charges.each do |charge| %>
        <div class="flex items-start justify-between gap-6 py-4 first:pt-0 last:pb-0">
          <div>
            <p class="font-semibold text-medical-navy">
              <%= charge.description %>
            </p>

            <p class="mt-1 text-sm text-medical-muted">
              <%= charge.charge_type.humanize %>
            </p>
          </div>

          <div class="text-right">
            <p class="font-semibold text-medical-navy">
              <%= charge.currency %>
              <%= number_with_precision(
                    charge.amount_cents / 100.0,
                    precision: 2
                  ) %>
            </p>

            <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-medical-muted">
              <%= charge.status.humanize %>
            </p>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-medical-muted">
      No charges have been added to this appointment.
    </p>
  <% end %>
</section>