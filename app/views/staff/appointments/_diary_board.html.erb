<%# Today-only board: appointments grouped by clinician, ordered by start time. %>
<% appointments_by_clinician = appointments.group_by(&:clinician_id) %>
<% if appointments.empty? && @current_staff_member.operational_access? %>
  <div class="border-b border-medical-border px-6 py-4">
    <%= link_to "Book appointment",
      new_practice_appointment_path,
      data: { turbo_frame: "_top" },
      class: "inline-flex items-center justify-center rounded-full bg-medical-navy px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-medical-navy-deep" %>
  </div>
<% end %>
<% if clinicians.any? %>
  <%# Use one shared time scale for every clinician, including appointments outside normal hours. %>
  <% local_slots = appointments.map do |appointment|
       slot = appointment.appointment_slot
       [slot.starts_at.in_time_zone(practice_timezone), slot.ends_at.in_time_zone(practice_timezone)]
     end %>
  <% earliest_hour = [8, *local_slots.map { |start_time, _| start_time.hour }].min %>
  <% latest_hour = [18, *local_slots.map { |_, end_time| end_time.hour + (end_time.min.positive? || end_time.sec.positive? ? 1 : 0) }].max %>
  <% minutes_in_diary = (latest_hour - earliest_hour) * 60 %>
  <% pixels_per_minute = 1.5 %>
  <% diary_height = minutes_in_diary * pixels_per_minute %>
  <div class="overflow-x-auto">
    <div class="flex min-w-max bg-white">
      <div class="sticky left-0 z-20 w-16 shrink-0 border-r border-medical-border bg-white">
        <div class="h-[73px] border-b border-medical-border bg-medical-cream"></div>
        <div class="relative" style="height: <%= diary_height %>px" aria-label="Time of day">
          <% (earliest_hour..latest_hour).each do |hour| %>
            <div class="absolute right-2 text-xs text-medical-muted" style="top: <%= (hour - earliest_hour) * 60 * pixels_per_minute %>px; transform: translateY(-50%)">
              <%= format("%02d:00", hour) %>
            </div>
          <% end %>
        </div>
      </div>
      <% clinicians.each do |clinician| %>
        <% clinician_appointments = (appointments_by_clinician[clinician.id] || []).sort_by { |appointment| appointment.appointment_slot.starts_at } %>
        <section class="w-48 shrink-0 border-r border-medical-border" aria-label="<%= clinician.full_name %> appointments">
          <header class="sticky top-0 z-10 flex h-[73px] flex-col justify-center border-b border-medical-border bg-medical-cream px-4">
            <h3 class="truncate font-semibold text-medical-navy" title="<%= clinician.full_name %>"><%= clinician.full_name %></h3>
            <p class="mt-1 text-xs text-medical-muted"><%= pluralize(clinician_appointments.size, "appointment") %></p>
          </header>
          <div class="relative" style="height: <%= diary_height %>px">
            <% (earliest_hour..latest_hour).each do |hour| %>
              <div class="pointer-events-none absolute inset-x-0 border-t border-medical-border" style="top: <%= (hour - earliest_hour) * 60 * pixels_per_minute %>px"></div>
            <% end %>
            <% clinician_appointments.each do |appointment| %>
              <% starts_at = appointment.appointment_slot.starts_at.in_time_zone(practice_timezone) %>
              <% ends_at = appointment.appointment_slot.ends_at.in_time_zone(practice_timezone) %>
              <% start_minutes = (starts_at.hour - earliest_hour) * 60 + starts_at.min + starts_at.sec / 60.0 %>
              <% duration_minutes = (ends_at - starts_at) / 60.0 %>
              <% balance = appointment_balances.fetch(appointment.id) %>
              <% payment_label = if balance[:balance_cents].negative?
                   "Credit"
                 elsif balance[:charged_cents].zero?
                   "No charge"
                 elsif balance[:balance_cents].zero?
                   "Paid"
                 elsif balance[:paid_cents].positive?
                   "Part paid"
                 else
                   "Unpaid"
                 end %>
              <%= link_to practice_appointment_path(appointment),
                class: "absolute inset-x-1 z-[1] overflow-hidden rounded-lg border border-medical-teal bg-medical-teal-soft px-2 py-1 text-xs text-medical-navy shadow-sm hover:z-10 hover:bg-white focus:z-10 focus:outline-none focus:ring-2 focus:ring-medical-teal",
                style: "top: #{start_minutes * pixels_per_minute}px; height: #{duration_minutes * pixels_per_minute}px",
                title: "#{starts_at.strftime('%H:%M')}–#{ends_at.strftime('%H:%M')} · #{"#{appointment.patient.first_name} #{appointment.patient.last_name}"} · #{appointment.status.humanize} · #{payment_label}",
                data: { turbo_frame: "_top", diary_appointment: true, start: starts_at.strftime("%H:%M"), end: ends_at.strftime("%H:%M") } do %>
                <span class="block font-bold"><%= starts_at.strftime("%H:%M") %>–<%= ends_at.strftime("%H:%M") %></span>
                <span class="block truncate font-semibold"><%= appointment.patient.first_name %> <%= appointment.patient.last_name %></span>
                <span class="block truncate"><%= appointment.status.humanize %> · <%= payment_label %></span>
                <% if appointment.reason.present? %>
                  <span class="block truncate"><%= appointment.reason %></span>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="px-6 py-12 text-center text-sm text-medical-muted">
    No active clinicians are available for the diary.
  </div>
<% end %>
