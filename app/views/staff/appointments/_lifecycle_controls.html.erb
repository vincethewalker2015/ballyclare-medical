<div id="appointment_lifecycle_controls">
  <% if allowed_status_transitions.any? %>
    <div class="mt-8 border-t border-medical-border pt-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h3 class="font-semibold text-medical-navy">
            Appointment status
          </h3>

          <p class="mt-1 text-sm text-medical-muted">
            Update this appointment as the patient moves through their visit.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <% allowed_status_transitions.each do |next_status| %>
            <%= button_to(
                  case next_status
                  when "confirmed" then "Confirm"
                  when "arrived" then "Mark arrived"
                  when "in_consultation" then "Start consultation"
                  when "completed" then "Complete"
                  when "referred" then "Refer"
                  when "cancelled" then "Cancel appointment"
                  when "did_not_attend" then "Mark did not attend"
                  else next_status.humanize
                  end,
                  status_practice_appointment_path(appointment),
                  method: :patch,
                  params: { status: next_status },
                  class: "inline-flex cursor-pointer items-center justify-center rounded-xl border border-medical-border bg-white px-4 py-2.5 text-sm font-semibold text-medical-navy shadow-sm transition hover:bg-medical-cream focus:outline-none focus:ring-2 focus:ring-medical-navy focus:ring-offset-2"
                ) %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
