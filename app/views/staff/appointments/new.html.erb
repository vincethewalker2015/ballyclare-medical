<% content_for :title, "Book appointment | Ballyclare Medical" %>

<div class="mx-auto max-w-5xl">
  <div class="mb-8 flex items-start justify-between gap-6">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-medical-teal">
        Appointments
      </p>

      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-medical-navy">
        Book appointment
      </h1>

      <p class="mt-2 max-w-2xl text-sm leading-6 text-medical-muted">
        Book an appointment on behalf of a patient.
      </p>
    </div>

    <%= link_to "Back to appointments",
                practice_appointments_path,
                class: "text-sm font-semibold text-medical-teal hover:text-medical-teal-dark" %>
  </div>

  <div class="rounded-2xl border border-medical-border bg-white p-8 shadow-sm">
    <%= form_with url: practice_appointments_path,
                  method: :post,
                  data: {
                    controller: "appointment-booking",
                    slots_url: available_slots_practice_appointments_path
                  } do |form| %>

      <div class="space-y-8">
        <div>
          <%= form.label :patient_id,
                         "Patient",
                         class: "mb-2 block text-sm font-semibold text-medical-navy" %>

          <div data-controller="patient-picker"
               data-patient-picker-url-value="<%= search_patients_practice_appointments_path %>"
               class="relative">
            <%= form.hidden_field :patient_id,
                  value: @selected_patient&.id,
                  data: { patient_picker_target: "value" } %>
            <input type="text"
                   id="patient_search"
                   role="combobox"
                   aria-label="Select patient"
                   aria-autocomplete="list"
                   aria-expanded="false"
                   aria-controls="patient-search-results"
                   autocomplete="off"
                   placeholder="Select patient"
                   value="<%= @selected_patient && "#{@selected_patient.last_name}, #{@selected_patient.first_name} — #{@selected_patient.patient_number}" %>"
                   data-patient-picker-target="input"
                   data-action="input->patient-picker#search focus->patient-picker#search keydown->patient-picker#keyDown blur->patient-picker#blur"
                   class="block w-full rounded-xl border border-medical-border bg-white px-4 py-3 text-base text-medical-ink shadow-sm outline-none transition placeholder:text-medical-muted focus:border-medical-teal focus:ring-4 focus:ring-medical-teal/10">
            <ul id="patient-search-results"
                role="listbox"
                data-patient-picker-target="results"
                class="absolute z-20 mt-1 hidden max-h-72 w-full overflow-y-auto rounded-xl border border-medical-border bg-white shadow-lg"></ul>
          </div>
        </div>

        <div>
          <%= form.label :clinician_id,
                         "Clinician",
                         class: "mb-2 block text-sm font-semibold text-medical-navy" %>

          <%= render "shared/select_field",
                     form: form,
                     field: :clinician_id,
                     collection: @clinicians,
                     value_method: :id,
                     text_method: ->(clinician) { clinician.full_name },
                     options: { prompt: "Select a clinician" },
                     html_options: {
                       data: {
                         appointment_booking_target: "clinician",
                         action: "change->appointment-booking#loadSlots"
                       }
                     } %>
        </div>

        <div>
          <%= form.label :date, "Appointment date", class: "mb-2 block text-sm font-semibold text-medical-navy" %>
          <%= form.date_field :date,
            value: @booking_date.iso8601,
            min: @booking_date.iso8601,
            data: { appointment_booking_target: "date", action: "change->appointment-booking#loadSlots" },
            class: "rounded-xl border border-medical-border bg-white px-4 py-3 text-base text-medical-ink" %>
        </div>

        <div>
          <div class="mb-3">
            <h2 class="text-sm font-semibold text-medical-navy">
              Available appointment
            </h2>

            <p class="mt-1 text-sm leading-6 text-medical-muted">
              Choose an available time for the selected clinician.
            </p>
          </div>

          <%= turbo_frame_tag "available_appointment_slots" do %>
            <div class="rounded-xl border border-medical-border bg-medical-cream px-5 py-4">
              <p class="text-sm text-medical-muted">
                Select a clinician to view available appointments.
              </p>
            </div>
          <% end %>
        </div>

        <div>
          <%= form.label :reason,
                         "Reason for appointment",
                         class: "mb-2 block text-sm font-semibold text-medical-navy" %>

          <%= form.text_area :reason,
                             rows: 4,
                             placeholder: "Enter the reason for the appointment",
                             class: "block w-full rounded-xl border border-medical-border bg-white px-4 py-3 text-base text-medical-ink shadow-sm outline-none transition placeholder:text-medical-muted focus:border-medical-teal focus:ring-4 focus:ring-medical-teal/10" %>

          <p class="mt-2 text-sm text-medical-muted">
            Add a brief reason to help the clinician prepare for the appointment.
          </p>
        </div>

        <div class="rounded-xl border border-medical-border bg-medical-cream px-5 py-4">
          <p class="text-sm font-semibold text-medical-navy">Consultation fee</p>
          <p class="mt-1 text-sm text-medical-muted">The fee for your selected clinician is applied automatically when you book.</p>
          <p class="mt-2 text-sm font-semibold text-medical-navy"
             data-appointment-booking-target="fee"
             aria-live="polite">Select a clinician to see the consultation fee.</p>
          <% @clinicians.each do |clinician| %>
            <% fee = @fees_by_type[clinician.staff_type] %>
            <span hidden
                  data-appointment-booking-target="feeOption"
                  data-clinician-id="<%= clinician.id %>"
                  data-fee-label="<%= fee ? number_to_currency(fee.amount_cents / 100.0, unit: fee.currency == "GBP" ? "£" : "#{fee.currency} ") : "Consultation fee not configured" %>"></span>
          <% end %>
        </div>

        <div class="flex items-center justify-end border-t border-medical-border pt-6">
          <%= form.submit "Book appointment",
                          class: "cursor-pointer rounded-xl bg-medical-navy px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-medical-navy-deep focus:outline-none focus:ring-2 focus:ring-medical-navy focus:ring-offset-2" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
