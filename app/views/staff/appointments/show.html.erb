<% content_for :title, "Appointment | Ballyclare Medical" %>

<%
  local_time = @appointment
    .appointment_slot
    .starts_at
    .in_time_zone(@appointment.practice.timezone)

  currency = @balance[:currency]
%>

<div class="mx-auto max-w-5xl">
  <div class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-medical-teal">
        Appointments
      </p>

      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-medical-navy">
        Appointment
      </h1>

      <p class="mt-2 text-sm leading-6 text-medical-muted">
        <%= @appointment.patient.first_name %>
        <%= @appointment.patient.last_name %>
        ·
        <%= local_time.strftime("%A, %d %B %Y at %H:%M") %>
      </p>
    </div>

    <%= link_to "Back to appointments",
                practice_appointments_path,
                class: "text-sm font-semibold text-medical-teal hover:text-medical-teal-dark" %>
  </div>

  <div class="space-y-6">
    <section class="rounded-2xl border border-medical-border bg-white p-8 shadow-sm">
      <div class="mb-6 flex items-center justify-between gap-4">
        <h2 class="text-lg font-semibold text-medical-navy">
          Appointment details
        </h2>

        <span class="rounded-full bg-medical-teal-soft px-3 py-1 text-xs font-semibold capitalize text-medical-teal-dark">
          <%= @appointment.status.humanize %>
        </span>
      </div>

      <dl class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-medical-muted">
            Patient
          </dt>

          <dd class="mt-1 font-semibold text-medical-navy">
            <%= @appointment.patient.first_name %>
            <%= @appointment.patient.last_name %>
          </dd>

          <p class="mt-1 text-sm text-medical-muted">
            <%= @appointment.patient.patient_number %>
          </p>
        </div>

        <div>
          <dt class="text-sm font-medium text-medical-muted">
            Clinician
          </dt>

          <dd class="mt-1 font-semibold text-medical-navy">
            <%= @appointment.clinician.full_name %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-medical-muted">
            Date
          </dt>

          <dd class="mt-1 font-semibold text-medical-navy">
            <%= local_time.strftime("%A, %d %B %Y") %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-medical-muted">
            Time
          </dt>

          <dd class="mt-1 font-semibold text-medical-navy">
            <%= local_time.strftime("%H:%M") %>
          </dd>
        </div>

        <div class="sm:col-span-2">
          <dt class="text-sm font-medium text-medical-muted">
            Reason
          </dt>

          <dd class="mt-1 text-medical-ink">
            <%= @appointment.reason.presence || "No reason provided" %>
          </dd>
        </div>
      </dl>
    </section>

    <section class="rounded-2xl border border-medical-border bg-white p-8 shadow-sm">
      <div class="mb-6">
        <h2 class="text-lg font-semibold text-medical-navy">
          Financial summary
        </h2>

        <p class="mt-1 text-sm text-medical-muted">
          Charges, payments and outstanding balance for this appointment.
        </p>
      </div>

      <dl class="divide-y divide-medical-border">
        <div class="flex items-center justify-between gap-6 py-4 first:pt-0">
          <dt class="text-sm text-medical-muted">
            Charges
          </dt>

          <dd class="font-semibold text-medical-navy">
            <%= currency %>
            <%= number_with_precision(
                  @balance[:charged_cents] / 100.0,
                  precision: 2
                ) %>
          </dd>
        </div>

        <div class="flex items-center justify-between gap-6 py-4">
          <dt class="text-sm text-medical-muted">
            Payments
          </dt>

          <dd class="font-semibold text-medical-navy">
            <%= currency %>
            <%= number_with_precision(
                  @balance[:paid_cents] / 100.0,
                  precision: 2
                ) %>
          </dd>
        </div>

        <div class="flex items-center justify-between gap-6 py-4">
          <dt class="text-sm text-medical-muted">
            Refunds
          </dt>

          <dd class="font-semibold text-medical-navy">
            <%= currency %>
            <%= number_with_precision(
                  @balance[:refunded_cents] / 100.0,
                  precision: 2
                ) %>
          </dd>
        </div>

        <div class="flex items-center justify-between gap-6 pt-5">
          <dt class="font-semibold text-medical-navy">
            Outstanding balance
          </dt>

          <dd class="text-xl font-semibold text-medical-navy">
            <%= currency %>
            <%= number_with_precision(
                  @balance[:balance_cents] / 100.0,
                  precision: 2
                ) %>
          </dd>
        </div>
      </dl>

      <% if @balance[:balance_cents].positive? %>
        <div class="mt-6 flex justify-end border-t border-medical-border pt-6">
          <%= link_to "Take payment",
            new_practice_appointment_payment_path(@appointment),
            class: "inline-flex cursor-pointer items-center justify-center rounded-xl bg-medical-navy px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-medical-navy-deep focus:outline-none focus:ring-2 focus:ring-medical-navy focus:ring-offset-2" %>
        </div>
      <% end %>
    </section>

    <section class="rounded-2xl border border-medical-border bg-white p-8 shadow-sm">
      <div class="mb-6">
        <h2 class="text-lg font-semibold text-medical-navy">
          Charges
        </h2>

        <p class="mt-1 text-sm text-medical-muted">
          Charges associated with this appointment.
        </p>
      </div>

      <% if @appointment.appointment_charges.any? %>
        <div class="divide-y divide-medical-border">
          <% @appointment.appointment_charges.each do |charge| %>
            <div class="flex items-start justify-between gap-6 py-4 first:pt-0 last:pb-0">
              <div>
                <p class="font-semibold text-medical-navy">
                  <%= charge.description %>
                </p>

                <p class="mt-1 text-sm text-medical-muted">
                  <%= charge.charge_type.humanize %>
                </p>
              </div>

              <div class="text-right">
                <p class="font-semibold text-medical-navy">
                  <%= charge.currency %>
                  <%= number_with_precision(
                        charge.amount_cents / 100.0,
                        precision: 2
                      ) %>
                </p>

                <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-medical-muted">
                  <%= charge.status.humanize %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-medical-muted">
          No charges have been added to this appointment.
        </p>
      <% end %>
    </section>
  </div>
</div>
