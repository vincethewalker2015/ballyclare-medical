<%
  if availability_block.persisted?
    local_starts_at =
      availability_block.starts_at.in_time_zone(availability_block.practice.timezone)

    local_ends_at =
      availability_block.ends_at.in_time_zone(availability_block.practice.timezone)
  end

  selected_date =
    params.dig(:availability_block, :date).presence ||
    local_starts_at&.strftime("%Y-%m-%d")

  selected_start =
    params.dig(:availability_block, :starts_at).presence ||
    local_starts_at&.strftime("%H:%M")

  selected_end =
    params.dig(:availability_block, :ends_at).presence ||
    local_ends_at&.strftime("%H:%M")

  time_options =
    (7..18).flat_map do |hour|
      (0...60).step(5).filter_map do |minute|
        next if hour == 18 && minute > 0

        time = format("%02d:%02d", hour, minute)
        [time, time]
      end
    end
%>

<section class="rounded-2xl border border-medical-border bg-white p-8 shadow-sm">
  <% if availability_block.errors.any? %>
    <div class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4">
      <p class="font-semibold text-red-800">
        Availability could not be saved.
      </p>

      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700">
        <% availability_block.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: availability_block,
                url: form_url,
                class: "space-y-6" do |form| %>

    <div>
      <%= form.label :clinician_id,
                     "Clinician",
                     class: "block text-sm font-semibold text-medical-navy" %>

      <div class="relative mt-2">
        <%= form.collection_select :clinician_id,
                                   clinicians,
                                   :id,
                                   :full_name,
                                   { prompt: "Select clinician" },
                                   class: "block w-full appearance-none rounded-xl border border-medical-border bg-white px-4 py-3 pr-10 text-medical-ink shadow-sm transition hover:border-medical-teal focus:border-medical-teal focus:outline-none focus:ring-2 focus:ring-medical-teal/20" %>

        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-medical-muted">
          <svg
            class="h-4 w-4"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true">
            <path
              d="m6 8 4 4 4-4"
              stroke-linecap="round"
              stroke-linejoin="round" />
          </svg>
        </div>
      </div>
    </div>

    <div>
      <%= form.label :date,
                     "Date",
                     class: "block text-sm font-semibold text-medical-navy" %>

      <%= form.date_field :date,
                          value: selected_date,
                          class: "mt-2 block w-full rounded-xl border border-medical-border bg-white px-4 py-3 text-medical-ink shadow-sm transition hover:border-medical-teal focus:border-medical-teal focus:outline-none focus:ring-2 focus:ring-medical-teal/20" %>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <%= form.label :starts_at,
                       "Start time",
                       class: "block text-sm font-semibold text-medical-navy" %>

        <div class="relative mt-2">
          <%= form.select :starts_at,
                          options_for_select(
                            time_options,
                            selected_start
                          ),
                          { prompt: "Select start time" },
                          class: "block w-full appearance-none rounded-xl border border-medical-border bg-white px-4 py-3 pr-10 text-medical-ink shadow-sm transition hover:border-medical-teal focus:border-medical-teal focus:outline-none focus:ring-2 focus:ring-medical-teal/20" %>

          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-medical-muted">
            <svg
              class="h-4 w-4"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true">
              <path
                d="m6 8 4 4 4-4"
                stroke-linecap="round"
                stroke-linejoin="round" />
            </svg>
          </div>
        </div>
      </div>

      <div>
        <%= form.label :ends_at,
                       "End time",
                       class: "block text-sm font-semibold text-medical-navy" %>

        <div class="relative mt-2">
          <%= form.select :ends_at,
                          options_for_select(
                            time_options,
                            selected_end
                          ),
                          { prompt: "Select end time" },
                          class: "block w-full appearance-none rounded-xl border border-medical-border bg-white px-4 py-3 pr-10 text-medical-ink shadow-sm transition hover:border-medical-teal focus:border-medical-teal focus:outline-none focus:ring-2 focus:ring-medical-teal/20" %>

          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-medical-muted">
            <svg
              class="h-4 w-4"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true">
              <path
                d="m6 8 4 4 4-4"
                stroke-linecap="round"
                stroke-linejoin="round" />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <div>
      <%= form.label :slot_duration_minutes,
                     "Appointment duration",
                     class: "block text-sm font-semibold text-medical-navy" %>

      <div class="relative mt-2">
        <%= form.select :slot_duration_minutes,
                        [
                          ["15 minutes", 15],
                          ["20 minutes", 20],
                          ["30 minutes", 30],
                          ["45 minutes", 45],
                          ["60 minutes", 60]
                        ],
                        {},
                        class: "block w-full appearance-none rounded-xl border border-medical-border bg-white px-4 py-3 pr-10 text-medical-ink shadow-sm transition hover:border-medical-teal focus:border-medical-teal focus:outline-none focus:ring-2 focus:ring-medical-teal/20" %>

        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-medical-muted">
          <svg
            class="h-4 w-4"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true">
            <path
              d="m6 8 4 4 4-4"
              stroke-linecap="round"
              stroke-linejoin="round" />
          </svg>
        </div>
      </div>
    </div>

    <div class="rounded-xl border border-medical-border bg-medical-cream p-4">
      <label class="flex items-start gap-3">
        <%= form.check_box :bookable_online,
                           class: "mt-1 h-4 w-4 rounded border-medical-border text-medical-teal focus:ring-medical-teal" %>

        <span>
          <span class="block text-sm font-semibold text-medical-navy">
            Allow online booking
          </span>

          <span class="mt-1 block text-sm leading-5 text-medical-muted">
            Patients can see and book generated slots from this availability period.
          </span>
        </span>
      </label>
    </div>

    <div class="flex flex-col-reverse gap-3 border-t border-medical-border pt-6 sm:flex-row sm:justify-end">
      <%= link_to "Cancel",
                  practice_availability_blocks_path,
                  class: "inline-flex items-center justify-center rounded-xl border border-medical-border bg-white px-5 py-3 text-sm font-semibold text-medical-navy hover:bg-medical-cream" %>

      <%= form.submit submit_label,
                      class: "inline-flex cursor-pointer items-center justify-center rounded-xl bg-medical-navy px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-medical-navy-deep focus:outline-none focus:ring-2 focus:ring-medical-navy focus:ring-offset-2" %>
    </div>
  <% end %>
</section>
