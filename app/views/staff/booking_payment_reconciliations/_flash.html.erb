<% if flash[:notice].present? %>
  <div class="mx-auto mb-6 max-w-6xl rounded-xl border border-medical-teal/20 bg-medical-teal-soft px-4 py-3 text-sm font-medium text-medical-teal-dark"><%= flash[:notice] %></div>
<% end %>
<% if flash[:alert].present? %>
  <div class="mx-auto mb-6 max-w-6xl rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-800"><%= flash[:alert] %></div>
<% end %>
