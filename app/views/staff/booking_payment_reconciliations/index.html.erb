<% content_for :title, "Booking payment reconciliation | Ballyclare Medical" %>

<div class="mx-auto max-w-7xl">
  <h1 class="text-3xl font-semibold text-medical-navy">Booking payments requiring reconciliation</h1>
  <p class="mt-3 max-w-4xl text-medical-muted">Payments listed here have remained pending or processing for at least 15 minutes. Check the payment in Stripe before taking any further payment or booking action.</p>
  <p class="mt-2 max-w-4xl text-sm text-medical-muted">Enter the matching Stripe PaymentIntent ID to verify its outcome. The Stripe status shown below is the last audited check, not a live status. Verification is audited and does not initiate a new charge.</p>

  <%= form_with url: practice_booking_payment_reconciliations_path, method: :get, local: true, role: "search", class: "mt-6 flex flex-wrap items-center gap-3" do |form| %>
    <%= form.search_field :payment_search, value: @payment_search,
      placeholder: "Search by patient name, payment reference or Stripe ID",
      aria: { label: "Search booking payments" },
      class: "min-w-0 flex-1 rounded-xl border border-medical-border bg-white px-4 py-3 text-sm text-medical-navy focus:border-medical-teal focus:ring-medical-teal" %>
    <%= form.submit "Search", class: "cursor-pointer rounded-full bg-medical-teal px-6 py-3 text-sm font-semibold text-white" %>
    <% if @payment_search.present? %>
      <%= link_to "Clear", practice_booking_payment_reconciliations_path, class: "text-sm font-semibold text-medical-teal-dark hover:underline" %>
    <% end %>
  <% end %>

  <div class="mt-5 overflow-x-auto rounded-2xl border border-medical-border bg-white">
    <% if @payments.any? %>
      <table class="w-full min-w-[1050px] text-left text-sm">
        <thead class="bg-medical-teal-soft text-medical-navy">
          <tr>
            <th scope="col" class="px-5 py-4">Payment reference</th>
            <th scope="col" class="px-5 py-4">Patient / booking</th>
            <th scope="col" class="px-5 py-4">Local status</th>
            <th scope="col" class="px-5 py-4">Stripe status (last checked)</th>
            <th scope="col" class="px-5 py-4">Last updated</th>
            <th scope="col" class="px-5 py-4">Stripe PaymentIntent</th>
            <th scope="col" class="px-4 py-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @payments.each do |payment| %>
            <tr class="border-t border-medical-border align-top">
              <td class="max-w-48 break-all px-5 py-5 font-mono text-xs text-medical-navy"><%= payment.id %></td>
              <td class="min-w-44 px-5 py-5 text-medical-navy">
                <% if payment.patient.present? %>
                  <span class="block font-medium"><%= [payment.patient.first_name, payment.patient.last_name].join(" ") %></span>
                  <span class="mt-1 block text-xs text-medical-muted">Registered patient</span>
                <% elsif payment.guest_booking.present? %>
                  <span class="block font-medium"><%= [payment.guest_booking.first_name, payment.guest_booking.last_name].reject(&:blank?).join(" ").presence || "Name unavailable" %></span>
                  <span class="mt-1 block text-xs text-medical-muted">Guest booking</span>
                <% else %>
                  <span class="font-medium text-amber-900">Unknown — investigate</span>
                <% end %>
              </td>
              <td class="px-5 py-5">
                <span class="inline-block rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-900"><%= payment.status.humanize %></span>
              </td>
              <td class="min-w-48 px-5 py-5 text-medical-navy">
                <% verification = @stripe_verifications[payment.id] %>
                <% if verification&.action == "stripe_payment.verification_matched" && verification.metadata["payment_intent_id"] == payment.provider_payment_id %>
                  <span class="font-medium"><%= verification.metadata["stripe_status"].to_s.humanize %></span>
                  <span class="mt-1 block text-xs text-medical-muted">Checked <%= l(verification.created_at, format: :long) %> — historical, not live</span>
                <% elsif verification&.action == "stripe_payment.verification_unavailable" %>
                  <span class="font-medium text-amber-900">Stripe unavailable</span>
                  <span class="mt-1 block text-xs text-medical-muted">Checked <%= l(verification.created_at, format: :long) %> — retry verification</span>
                <% else %>
                  <span class="text-medical-muted">Not checked</span>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-5 py-5 text-medical-muted"><%= l(payment.updated_at, format: :long) %></td>
              <td class="max-w-56 break-all px-5 py-5 font-mono text-xs text-medical-navy">
                <%= payment.provider_payment_id.presence || "Not recorded — manual verification required" %>
              </td>
              <td class="min-w-60 px-4 py-5">
                <%= form_with url: verify_practice_booking_payment_reconciliation_path(payment), method: :post, local: true do |form| %>
                  <div class="flex flex-col gap-2">
                    <%= form.label :payment_intent_id, "Stripe PaymentIntent ID", class: "text-xs font-semibold text-medical-navy" %>
                    <%= form.text_field :payment_intent_id, value: payment.provider_payment_id, required: true, pattern: "pi_[a-zA-Z0-9_]+", autocomplete: "off", placeholder: "pi_...", class: "w-full rounded-xl border border-medical-border bg-white px-3 py-2 text-sm text-medical-navy focus:border-medical-teal focus:outline-none focus:ring-2 focus:ring-medical-teal/20" %>
                    <%= form.submit "Verify payment with Stripe", class: "cursor-pointer rounded-xl bg-medical-navy px-4 py-2.5 text-sm font-semibold text-white transition hover:opacity-90" %>
                  </div>
                <% end %>
                <div class="mt-4 border-t border-medical-border pt-3">
                <% if payment.provider_payment_id.present? %>
                  <p class="mb-2 text-xs text-medical-muted">Only cancel after confirming this payment was abandoned. Cancellation prevents further payment attempts using this Stripe PaymentIntent and cannot be undone.</p>
                  <%= form_with url: cancel_practice_booking_payment_reconciliation_path(payment), method: :post, local: true do |form| %>
                    <%= form.hidden_field :payment_intent_id, value: payment.provider_payment_id %>
                    <%= form.submit "Cancel abandoned payment", data: { turbo_confirm: "Cancel Stripe PaymentIntent #{payment.provider_payment_id}? This will stop further payment attempts using this PaymentIntent. It will not refund a successful payment. Continue?" }, class: "cursor-pointer rounded-xl border border-amber-600 px-4 py-2.5 text-sm font-semibold text-amber-900 hover:bg-amber-50" %>
                  <% end %>
                <% else %>
                  <span class="text-xs text-medical-muted">Verify the Stripe reference first.</span>
                <% end %>
              </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-5 py-8 text-medical-muted"><%= @payment_search.present? ? "No matching unresolved booking payments in this practice." : "No unresolved booking payments currently require review." %></p>
    <% end %>
  </div>
</div>
