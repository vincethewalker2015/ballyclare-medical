<% content_for :title, "User Manual | Ballyclare Medical" %>

<div id="manual-page-top" class="mx-auto max-w-4xl">
  <div class="mb-8">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-medical-teal">
      Help &amp; documentation
    </p>

    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-medical-navy">
      User Manual
    </h1>

    <p class="mt-2 text-sm text-medical-muted">
      A practical guide for Ballyclare Medical staff.
    </p>
  </div>

  <article class="user-manual-markdown rounded-2xl border border-medical-border bg-white p-6 shadow-sm sm:p-10">
    <%= sanitize(
          @manual_html,
          tags: %w[h1 h2 h3 h4 p ul ol li strong em a img code pre blockquote hr table thead tbody tr th td],
          attributes: %w[href src alt title id]
        ) %>
  </article>
</div>

<%# Navigation aid for the web manual only; not part of the Markdown document. %>
<a href="#manual-page-top"
   aria-label="Return to top of User Manual"
   title="Back to top"
   class="fixed bottom-6 left-4 z-40 inline-flex items-center gap-2 rounded-full bg-medical-navy px-4 py-3 text-sm font-semibold text-white shadow-lg transition hover:bg-medical-navy-deep focus:outline-none focus:ring-2 focus:ring-medical-teal focus:ring-offset-2 print:hidden sm:left-6">
  <span aria-hidden="true">↑</span>
  <span>Top</span>
</a>
