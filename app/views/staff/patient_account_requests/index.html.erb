<% content_for :title, "Patient account requests | Ballyclare Medical" %>

<div class="mx-auto max-w-5xl">
  <h1 class="text-3xl font-semibold text-medical-navy">Patient account requests</h1>
  <p class="mt-3 text-medical-muted">Accounts already assigned to this practice for review. Unassigned online registrations are not displayed because their practice has not been verified.</p>

  <div class="mt-8 overflow-hidden rounded-2xl border border-medical-border bg-white">
    <% if @links.any? %>
      <table class="w-full text-left text-sm">
        <thead class="bg-medical-teal-soft text-medical-navy">
          <tr><th class="px-5 py-4">Email address</th><th class="px-5 py-4">Confirmed</th><th class="px-5 py-4">Status</th></tr>
        </thead>
        <tbody>
          <% @links.each do |link| %>
            <tr class="border-t border-medical-border">
              <td class="px-5 py-4"><%= link.patient_account.email %></td>
              <td class="px-5 py-4"><%= l(link.patient_account.confirmed_at, format: :long) %></td>
              <td class="px-5 py-4">Awaiting review</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-5 py-8 text-medical-muted">No practice-assigned accounts awaiting review. New online registrations cannot yet be assigned through this screen.</p>
    <% end %>
  </div>
  <p class="mt-5 text-sm text-medical-muted">Identity verification and record linking will be available in a subsequent release. Do not link accounts by email address alone.</p>
</div>
