<% content_for :title, "Patient account requests | Ballyclare Medical" %>

<div class="mx-auto max-w-5xl">
  <h1 class="text-3xl font-semibold text-medical-navy">Patient account requests</h1>
  <p class="mt-3 text-medical-muted">Patients have selected this practice during registration. This is an unverified request, not evidence of identity or a connection to a clinical record.</p>

  <%= form_with url: practice_patient_account_requests_path, method: :get, class: "mt-7 flex flex-wrap gap-3", role: "search" do |form| %>
    <%= form.search_field :request_search, value: @request_search, placeholder: "Search by applicant name or email", aria: { label: "Search registration requests" }, class: "min-w-0 flex-1 rounded-xl border border-medical-border bg-white px-4 py-3 text-sm" %>
    <%= form.submit "Search", class: "cursor-pointer rounded-full bg-medical-navy px-6 py-3 text-sm font-semibold text-white" %>
    <% if @request_search.present? %><%= link_to "Clear", practice_patient_account_requests_path, class: "self-center text-sm font-semibold text-medical-teal-dark" %><% end %>
  <% end %>
  <div class="mt-8 overflow-hidden rounded-2xl border border-medical-border bg-white">
    <% if @registration_requests.any? %>
      <table class="w-full text-left text-sm">
        <thead class="bg-medical-teal-soft text-medical-navy">
          <tr><th class="px-5 py-4">Email address</th><th class="px-5 py-4">Email confirmed</th><th class="px-5 py-4">Status</th><th class="px-5 py-4">Review</th></tr>
        </thead>
        <tbody>
          <% @registration_requests.each do |request| %>
            <tr class="border-t border-medical-border">
              <td class="px-5 py-4"><%= request.patient_account.email %></td>
              <td class="px-5 py-4"><%= l(request.patient_account.confirmed_at, format: :long) %></td>
              <td class="px-5 py-4"><%= request.review_status.humanize %></td>
              <td class="px-5 py-4"><%= link_to "Review request", practice_patient_account_request_path(request), class: "font-semibold text-medical-teal-dark" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-5 py-8 text-medical-muted">No confirmed registration requests for this practice.</p>
    <% end %>
  </div>
  <nav aria-label="Registration request pages" class="mt-5 flex items-center justify-between gap-4 text-sm">
    <span class="text-medical-muted"><%= @request_count %> matching requests · Page <%= @page %> of <%= @total_pages %></span>
    <div class="flex gap-4">
      <% if @page > 1 %><%= link_to "Previous", practice_patient_account_requests_path(page: @page - 1, request_search: @request_search), class: "font-semibold text-medical-teal-dark" %><% end %>
      <% if @page < @total_pages %><%= link_to "Next", practice_patient_account_requests_path(page: @page + 1, request_search: @request_search), class: "font-semibold text-medical-teal-dark" %><% end %>
    </div>
  </nav>
  <p class="mt-5 text-sm text-medical-muted">Identity verification is required before Senior Staff Admin approval. No accounts are linked by email address alone.</p>
</div>
