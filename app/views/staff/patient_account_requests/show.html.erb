<% content_for :title, "Review patient registration | Ballyclare Medical" %>

<div class="mx-auto max-w-3xl">
  <%= link_to "Back to patient account requests", practice_patient_account_requests_path,
    class: "font-semibold text-medical-teal-dark" %>

  <h1 class="mt-6 text-3xl font-semibold text-medical-navy">Review patient registration</h1>
  <div class="mt-8 rounded-2xl border border-medical-border bg-white p-8">
    <p class="text-sm font-semibold text-medical-muted">Applicant-supplied details — not verified</p>
    <% if @registration_request.first_name.present? && @registration_request.last_name.present? %>
      <p class="mt-2 text-lg text-medical-navy"><%= @registration_request.first_name %> <%= @registration_request.last_name %></p>
      <p class="mt-2 text-medical-muted">Date of birth: <%= l(@registration_request.date_of_birth) if @registration_request.date_of_birth %></p>
    <% else %>
      <p class="mt-2 text-medical-muted">Not collected for this earlier registration. Contact the applicant and verify their identity using the approved procedure.</p>
    <% end %>
    <p class="mt-5 text-sm text-medical-muted">Do not link a clinical record solely because these details match.</p>
    <p class="text-sm font-semibold text-medical-muted">Confirmed account email</p>
    <p class="mt-2 text-lg text-medical-navy"><%= @registration_request.patient_account.email %></p>
    <p class="mt-5 text-sm font-semibold text-medical-muted">Email confirmed</p>
    <p class="mt-2"><%= l(@registration_request.patient_account.confirmed_at, format: :long) %></p>
    <p class="mt-5 text-sm font-semibold text-medical-muted">Status</p>
    <p class="mt-2"><%= @registration_request.review_status.humanize %></p>
    <% if @registration_request.review_status == "completed" %>
      <% approved_link = @registration_request.patient_account.patient_account_links
        .where(practice: @registration_request.practice, status: "approved")
        .includes(:patient).first %>
      <% if approved_link %>
        <div class="mt-5 rounded-xl border border-medical-border bg-medical-teal-soft p-4">
          <p class="font-semibold text-medical-navy">Clinical patient record created or connected</p>
          <p class="mt-2 text-sm text-medical-ink">Patient number: <strong><%= approved_link.patient.patient_number %></strong></p>
          <%= link_to "View clinical patient record", practice_patient_path(approved_link.patient),
            class: "mt-3 inline-block text-sm font-semibold text-medical-teal-dark underline" %>
        </div>
      <% end %>
    <% end %>

  </div>

  <% if @account_link %>
    <section class="mt-8 rounded-2xl border border-medical-border bg-white p-8">
      <h2 class="text-xl font-semibold text-medical-navy">Patient portal access</h2>
      <p class="mt-2 text-sm text-medical-muted">Current status: <strong><%= @account_link.status.humanize %></strong></p>
      <p class="mt-2 text-sm text-medical-muted">Clinical record: <%= @account_link.patient.patient_number %></p>
      <% if @current_staff_member.senior_administration_access? && @account_link.approved? %>
        <%= button_to "Revoke patient portal access", revoke_practice_patient_account_request_path(@account_link),
          method: :patch, form: { data: { turbo_confirm: "Revoke this patient's access to their clinical record through the portal?" } },
          class: "mt-5 cursor-pointer rounded-full border border-red-300 px-5 py-3 text-sm font-semibold text-red-800" %>
      <% elsif @current_staff_member.senior_administration_access? && @account_link.status == "revoked" %>
        <p class="mt-4 text-sm text-medical-muted">Before reinstating access, independently verify the patient's identity and ownership of this account using an approved practice procedure.</p>
        <%= form_with url: reinstate_practice_patient_account_request_path(@account_link), method: :patch, class: "mt-5 space-y-4" do |form| %>
          <div>
            <%= form.label :verification_method, "Fresh identity verification method", class: "block text-sm font-semibold text-medical-navy" %>
            <%= form.select :verification_method, [["In person", "in_person"], ["Approved remote procedure", "approved_remote"]], { prompt: "Select method" }, { required: true, class: "mt-2 w-full rounded-xl border border-medical-border px-4 py-3" } %>
          </div>
          <div>
            <%= form.label :reinstatement_reason, "Reason for reinstatement", class: "block text-sm font-semibold text-medical-navy" %>
            <%= form.text_area :reinstatement_reason, required: true, minlength: 10, rows: 3, class: "mt-2 w-full rounded-xl border border-medical-border px-4 py-3" %>
          </div>
          <label class="flex items-start gap-3 text-sm text-medical-navy">
            <%= form.check_box :identity_checked, required: true %>
            <span>I have freshly verified the patient's identity and confirmed ownership of this patient account.</span>
          </label>
          <%= form.submit "Reinstate patient portal access", data: { turbo_confirm: "Reinstate access to the linked clinical record?" }, class: "cursor-pointer rounded-full bg-medical-navy px-6 py-3 font-semibold text-white" %>
        <% end %>
      <% else %>
        <p class="mt-4 text-sm text-medical-muted">Only a Senior Staff Admin can change patient portal access.</p>
      <% end %>
    </section>
  <% end %>

  <div class="mt-8 rounded-2xl border border-medical-border bg-white p-8">
    <h2 class="text-xl font-semibold text-medical-navy">Identity verification</h2>
    <p class="mt-3 text-medical-muted">The practice must establish the patient's identity using its approved procedure before selecting and connecting a clinical record. Email confirmation alone is not sufficient.</p>
    <% if @registration_request.review_status == "awaiting_review" %>
      <%= form_with url: practice_patient_account_request_path(@registration_request), method: :get, class: "mt-6 flex flex-wrap gap-3" do |search_form| %>
        <%= search_form.search_field :patient_search, value: @patient_search, placeholder: "Search existing patient name or number", class: "min-w-0 flex-1 rounded-xl border border-medical-border bg-white px-4 py-3 text-sm text-medical-ink focus:border-medical-teal focus:ring-medical-teal" %>
        <%= search_form.submit "Find patient", class: "cursor-pointer rounded-full bg-medical-teal px-5 py-3 font-semibold text-white" %>
      <% end %>
      <%= form_with url: verify_practice_patient_account_request_path(@registration_request), method: :post, class: "mt-6 space-y-6 text-sm text-medical-ink" do |form| %>
        <fieldset class="space-y-3">
          <legend class="font-semibold text-medical-navy">Registration type</legend>
          <label class="flex items-center gap-2 text-sm text-medical-ink"><%= form.radio_button :patient_route, "new_patient", required: true %> New patient — create clinical record after approval</label>
          <label class="block"><%= form.radio_button :patient_route, "existing_patient", required: true %> Existing patient — connect verified clinical record</label>
        </fieldset>
        <% if @patient_search.present? && @matching_patients.empty? %>
          <p class="text-sm text-medical-muted">No matching existing clinical patient records.</p>
        <% end %>
        <% if @matching_patients.any? %>
          <fieldset class="space-y-3">
            <legend class="font-semibold text-medical-navy">Existing clinical record (only if selected above)</legend>
            <% @matching_patients.each do |patient| %>
              <label class="block rounded-xl border border-medical-border p-3 text-sm">
                <%= form.radio_button :patient_id, patient.id %>
                <%= patient.first_name %> <%= patient.last_name %> — DOB <%= l(patient.date_of_birth) %> — <%= patient.patient_number %>
              </label>
            <% end %>
          </fieldset>
        <% end %>
        <div>
          <%= form.label :verification_method, "Identity verification method", class: "block font-semibold text-medical-navy" %>
          <%= form.select :verification_method, [["In person — approved identity check", "in_person"], ["Remote — practice-approved identity procedure", "approved_remote"]], { prompt: "Select verification method" }, { required: true, class: "mt-2 w-full rounded-xl border border-medical-border bg-white px-4 py-3 text-sm text-medical-ink focus:border-medical-teal focus:ring-medical-teal" } %>
        </div>
        <label class="flex items-start gap-3 text-sm text-medical-navy">
          <%= form.check_box :identity_checked, required: true %>
          <span>I have independently verified the applicant's identity, checked the submitted details and confirmed whether this is a new or existing patient.</span>
        </label>
        <%= form.submit "Record identity verification", class: "cursor-pointer rounded-full bg-medical-navy px-6 py-3 font-semibold text-white" %>
      <% end %>
    <% else %>
      <p class="mt-4 font-semibold text-medical-navy">Status: <%= @registration_request.review_status.humanize %></p>
      <p class="mt-2 text-medical-muted">Route: <%= @registration_request.patient_route&.humanize %></p>
      <% if @registration_request.reviewed_by %>
        <p class="mt-2 text-medical-muted">Verified by <%= @registration_request.reviewed_by.full_name %> on <%= l(@registration_request.identity_verified_at, format: :long) %>.</p>
      <% end %>
    <% end %>
    <% if @registration_request.review_status == "verified" && @current_staff_member.senior_administration_access? %>
      <%= button_to "Approve patient registration", approve_practice_patient_account_request_path(@registration_request), method: :post, class: "mt-5 cursor-pointer rounded-full bg-medical-teal px-6 py-3 font-semibold text-white", form: { data: { confirm_action: "patient_registration" } }, data: { turbo_confirm: "Approve this verified request and create or connect the clinical patient record?" , confirm_action: "patient_registration" } %>
    <% elsif @registration_request.review_status == "verified" %>
      <p class="mt-4 text-medical-muted">Awaiting Senior Staff Admin approval.</p>
    <% end %>
  </div>
</div>
