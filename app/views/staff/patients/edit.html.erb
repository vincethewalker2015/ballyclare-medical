<% content_for :title, "Edit patient | Ballyclare Medical" %>

<div class="mx-auto max-w-2xl space-y-6">
  <header>
    <h1 class="text-4xl font-semibold text-medical-navy">Edit patient</h1>
  </header>

  <section class="rounded-2xl border border-medical-border bg-white p-6">
    <%= form_with model: @patient, url: practice_patient_path(@patient), class: "space-y-5" do |form| %>
      <% if @patient.errors.any? %>
        <div role="alert" class="rounded-lg bg-red-50 p-4 text-red-800">
          <p>Please correct the following:</p>
          <ul class="list-disc pl-5">
            <% @patient.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% [
        [ :patient_number, "Patient number" ],
        [ :first_name, "First name" ],
        [ :last_name, "Last name" ]
      ].each do |field, label| %>
        <div>
          <%= form.label field, label, class: "block text-sm font-semibold text-medical-navy" %>
          <%= form.text_field field, class: "mt-1 block w-full rounded-lg border border-medical-border p-3" %>
        </div>
      <% end %>

      <div>
        <%= form.label :date_of_birth, "Date of birth", class: "block text-sm font-semibold text-medical-navy" %>
        <%= form.date_field :date_of_birth, class: "mt-1 block w-full rounded-lg border border-medical-border p-3" %>
      </div>

      <div class="flex gap-4">
        <%= form.submit "Update patient", class: "rounded-full bg-medical-navy px-6 py-3 font-semibold text-white" %>
        <%= link_to "Cancel", practice_patient_path(@patient), class: "px-4 py-3 text-medical-navy" %>
      </div>
    <% end %>
  </section>
</div>
