<% content_for :title, "Patients | Ballyclare Medical" %>

<div class="space-y-6">
  <header>
    <h1 class="text-4xl font-semibold text-medical-navy">Patients</h1>
    <p class="mt-2 text-medical-muted">Patients registered with your practice.</p>
    <%= link_to "New patient", new_practice_patient_path, class: "mt-4 inline-flex rounded-full bg-medical-navy px-6 py-3 text-sm font-semibold text-white" %>
  </header>

  <section class="rounded-2xl border border-medical-border bg-white p-6">
    <%= form_with url: practice_patients_path, method: :get, class: "mb-5 flex flex-wrap items-center gap-3", role: "search" do |form| %>
      <%= form.search_field :patient_search, value: @patient_search,
        placeholder: "Search by name or patient number",
        aria: { label: "Search patients" },
        class: "min-w-0 flex-1 rounded-xl border border-medical-border bg-white px-4 py-3 text-sm text-medical-ink focus:border-medical-teal focus:ring-medical-teal" %>
      <%= form.submit "Search", class: "cursor-pointer rounded-full bg-medical-teal px-6 py-3 text-sm font-semibold text-white" %>
      <% if @patient_search.present? %>
        <%= link_to "Clear", practice_patients_path, class: "text-sm font-semibold text-medical-teal-dark hover:underline" %>
      <% end %>
    <% end %>

    <% if @patients.any? %>
      <p class="mb-3 text-xs text-medical-muted">Showing up to 100 patients. Search to narrow the list.</p>
      <div class="max-h-96 overflow-y-auto overscroll-contain" tabindex="0" role="region" aria-label="Patient list">
        <ul class="divide-y divide-medical-border">
          <% @patients.each do |patient| %>
            <li class="py-3 text-medical-ink">
              <%= link_to "#{patient.first_name} #{patient.last_name}", practice_patient_path(patient), class: "font-semibold text-medical-navy hover:underline" %>
              <span class="ml-2 text-sm text-medical-muted"><%= patient.patient_number %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% elsif @patient_search.present? %>
      <p class="text-medical-muted">No matching patients in this practice.</p>
    <% else %>
      <p class="text-medical-muted">No patients registered yet.</p>
    <% end %>
  </section>
</div>
