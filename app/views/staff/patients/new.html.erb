<% content_for :title, "New patient | Ballyclare Medical" %>

<div class="mx-auto max-w-2xl space-y-6">
  <header>
    <h1 class="text-4xl font-semibold text-medical-navy">New patient</h1>
    <p class="mt-2 text-medical-muted">Register a patient with your practice. A unique patient number will be assigned automatically.</p>
  </header>

  <section class="rounded-2xl border border-medical-border bg-white p-6">
    <%= form_with model: @patient, url: practice_patients_path, class: "space-y-5" do |form| %>
      <% if @patient.errors.any? %>
        <div role="alert" class="rounded-lg bg-red-50 p-4 text-red-800">
          <p>Please correct the following:</p>
          <ul class="list-disc pl-5">
            <% @patient.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% [
        [ :first_name, "First name" ],
        [ :last_name, "Last name" ]
      ].each do |field, label| %>
        <div>
          <%= form.label field, label, class: "block text-sm font-semibold text-medical-navy" %>
          <%= form.text_field field, class: "mt-1 block w-full rounded-lg border border-medical-border p-3" %>
        </div>
      <% end %>

      <div>
        <%= form.label :date_of_birth, "Date of birth", class: "block text-sm font-semibold text-medical-navy" %>
        <%= form.date_field :date_of_birth, class: "mt-1 block w-full rounded-lg border border-medical-border p-3" %>
      </div>

      <% if @current_staff_member.staff_administration_access? %>
        <fieldset class="rounded-xl border border-medical-border bg-medical-teal-soft p-5">
          <legend class="rounded-md bg-white px-3 py-1 text-base font-semibold text-medical-navy">Patient portal access (optional)</legend>
          <label class="mt-2 flex items-center gap-3 text-medical-navy">
            <%= check_box_tag "patient[invite_to_portal]", "1", @invite_to_portal, id: "patient_invite_to_portal" %>
            Send a portal invitation to this patient
          </label>
          <div class="mt-4">
            <%= label_tag "patient_email", "Patient email address", class: "block text-sm font-semibold text-medical-navy" %>
            <%= email_field_tag "patient[email]", params.dig(:patient, :email), id: "patient_email",
                autocomplete: "off", class: "mt-2 w-full rounded-lg border border-medical-border p-3" %>
          </div>
          <p class="mt-3 text-sm text-medical-muted">The patient confirms their email and sets their own password. Portal access requires separate identity verification and senior administrator approval.</p>
        </fieldset>
      <% end %>

      <div class="flex gap-4">
        <%= form.submit "Create patient", class: "rounded-full bg-medical-navy px-6 py-3 font-semibold text-white" %>
        <%= link_to "Cancel", practice_patients_path, class: "px-4 py-3 text-medical-navy" %>
      </div>
    <% end %>
  </section>
</div>
