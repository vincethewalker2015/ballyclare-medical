<% content_for :title, "Patient details | Ballyclare Medical" %>

<div class="mx-auto max-w-2xl space-y-6">
  <header>
    <h1 class="text-4xl font-semibold text-medical-navy"><%= @patient.first_name %> <%= @patient.last_name %></h1>
    <p class="mt-2 text-medical-muted">Patient number: <%= @patient.patient_number %></p>
  </header>

  <section class="rounded-2xl border border-medical-border bg-white p-6">
    <dl class="space-y-4">
      <div><dt class="text-sm font-semibold text-medical-muted">First name</dt><dd><%= @patient.first_name %></dd></div>
      <div><dt class="text-sm font-semibold text-medical-muted">Last name</dt><dd><%= @patient.last_name %></dd></div>
      <div><dt class="text-sm font-semibold text-medical-muted">Date of birth</dt><dd><%= @patient.date_of_birth %></dd></div>
    </dl>
  </section>

  <% if @current_staff_member.staff_administration_access? %>
    <section class="rounded-2xl border border-medical-border bg-white p-6">
      <h2 class="text-xl font-semibold text-medical-navy">Patient portal invitation</h2>
      <% if @patient.patient_account_link %>
        <p class="mt-3 text-medical-muted">This patient has an existing portal connection. Manage access from Patient accounts.</p>
      <% else %>
        <p class="mt-3 text-sm text-medical-muted">Invite this patient to create their own login. Email confirmation, independent identity verification and senior administrator approval are still required.</p>
        <%= form_with url: practice_patient_portal_invitation_path(@patient), method: :post, class: "mt-5 space-y-4" do |form| %>
          <div>
            <%= form.label :email, "Patient email address", class: "block text-sm font-semibold text-medical-navy" %>
            <%= form.email_field :email, value: @patient.email, required: true, autocomplete: "off", class: "mt-2 w-full rounded-xl border border-medical-border p-3" %>
          </div>
          <%= form.submit "Invite to patient portal", class: "rounded-full bg-medical-teal px-6 py-3 font-semibold text-white" %>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <div class="flex gap-4">
    <%= link_to "Edit patient", edit_practice_patient_path(@patient), class: "rounded-full bg-medical-navy px-6 py-3 text-sm font-semibold text-white" %>
    <%= link_to "Back to patients", practice_patients_path, class: "px-4 py-3 text-medical-navy" %>
  </div>
</div>
