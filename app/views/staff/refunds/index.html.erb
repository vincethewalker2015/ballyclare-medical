<% content_for :title, "Refund review | Ballyclare Medical" %>

<div class="mx-auto max-w-6xl">
  <h1 class="text-3xl font-semibold text-medical-navy">Refund review</h1>
  <p class="mt-3 text-medical-muted">Read-only view of the 100 most recent refunds for this practice. Failed and cancelled refunds require manual investigation; no refunds can be initiated here.</p>

  <div class="mt-8 overflow-x-auto rounded-2xl border border-medical-border bg-white">
    <% if @refunds.any? %>
      <table class="w-full text-left text-sm">
        <thead class="bg-medical-teal-soft text-medical-navy">
          <tr>
            <th class="px-5 py-4">Refund ID</th>
            <th class="px-5 py-4">Requested</th>
            <th class="px-5 py-4">Patient / booking</th>
            <th class="px-5 py-4">Amount</th>
            <th class="px-5 py-4">Status</th>
            <th class="px-5 py-4">Review</th>
          </tr>
        </thead>
        <tbody>
          <% @refunds.each do |refund| %>
            <% payment = refund.payment %>
            <tr class="border-t border-medical-border">
              <td class="break-all px-5 py-4 font-mono text-xs"><%= refund.id %></td>
              <td class="whitespace-nowrap px-5 py-4"><%= l(refund.requested_at, format: :long) %></td>
              <td class="px-5 py-4">
                <% if payment.patient %>
                  <%= payment.patient.first_name %> <%= payment.patient.last_name %>
                <% elsif payment.guest_booking %>
                  Guest booking
                <% else %>
                  Appointment payment
                <% end %>
              </td>
              <td class="whitespace-nowrap px-5 py-4"><%= number_to_currency(refund.amount_cents / 100.0, unit: refund.currency == "GBP" ? "£" : "#{refund.currency} ") %></td>
              <td class="px-5 py-4"><%= refund.status %></td>
              <td class="px-5 py-4">
                <% if %w[failed cancelled].include?(refund.status) %>
                  <span class="font-semibold text-red-700">Manual review required</span>
                <% elsif refund.status == "processing" %>
                  Awaiting Stripe confirmation
                <% else %>
                  <%= refund.status == "succeeded" ? "Completed" : "Pending" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-5 py-8 text-medical-muted">No refunds recorded for this practice.</p>
    <% end %>
  </div>
</div>
