<% content_for :title, "Edit staff member | Ballyclare Medical" %>

<div class="mx-auto max-w-2xl space-y-6">
  <h1 class="text-4xl font-semibold text-medical-navy">Edit staff member</h1>
  <p class="text-medical-muted">Update staff details for this practice. Access levels are managed separately by senior staff administrators.</p>

  <section class="rounded-2xl border border-medical-border bg-white p-6">
    <%= form_with model: @staff_member, url: practice_staff_member_path(@staff_member), class: "space-y-5" do |form| %>
      <% if @staff_member.errors.any? %>
        <div role="alert" class="rounded-lg bg-red-50 p-4 text-red-800">
          <ul class="list-disc pl-5">
            <% @staff_member.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% [ [ :first_name, "First name" ], [ :last_name, "Last name" ],
             [ :registration_number, "Registration number (optional)" ] ].each do |field, label| %>
        <div>
          <%= form.label field, label, class: "block text-sm font-semibold text-medical-navy" %>
          <%= form.text_field field, autocomplete: ({ first_name: "given-name", last_name: "family-name" }[field] || "off"),
            class: "mt-1 block w-full rounded-lg border border-medical-border p-3" %>
        </div>
      <% end %>

      <div>
        <%= form.label :staff_type, "Staff type", class: "block text-sm font-semibold text-medical-navy" %>
        <%= form.select :staff_type, StaffMember::STAFF_TYPES.map { |type| [ type.humanize, type ] },
          {}, class: "mt-1 block w-full rounded-lg border border-medical-border p-3" %>
      </div>

      <div class="flex gap-4">
        <%= form.submit "Save changes", class: "rounded-full bg-medical-navy px-6 py-3 font-semibold text-white" %>
        <%= link_to "Cancel", practice_staff_members_path, class: "px-4 py-3 text-medical-navy" %>
      </div>
    <% end %>
  </section>
</div>
