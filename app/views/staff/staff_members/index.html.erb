<% content_for :title, "Staff | Ballyclare Medical" %>

<div class="space-y-6">
  <header>
    <h1 class="text-4xl font-semibold text-medical-navy">Staff</h1>
    <p class="mt-2 text-medical-muted">People working at your practice.</p>
    <% if @current_staff_member.access_level.in?(%w[staff_admin senior_staff_admin]) %>
      <%= link_to "New staff member", new_practice_staff_member_path, class: "mt-4 inline-flex rounded-full bg-medical-navy px-6 py-3 text-sm font-semibold text-white" %>
    <% end %>
  </header>

  <section class="rounded-2xl border border-medical-border bg-white p-6">
    <% if @staff_members.any? %>
      <div class="hidden border-b border-medical-border pb-3 text-xs font-semibold uppercase tracking-wide text-medical-muted sm:grid sm:grid-cols-3 sm:gap-4">
        <span>Name</span>
        <span>Staff type</span>
        <span>Access level</span>
      </div>
      <ul class="divide-y divide-medical-border">
        <% @staff_members.each do |staff_member| %>
          <% type_style = {
            "doctor" => "bg-indigo-50 text-indigo-800 ring-indigo-200",
            "nurse" => "bg-emerald-50 text-emerald-800 ring-emerald-200",
            "administrator" => "bg-sky-50 text-sky-800 ring-sky-200"
          }.fetch(staff_member.staff_type, "bg-slate-50 text-slate-700 ring-slate-200") %>
          <% access_style = {
            "staff" => "bg-slate-100 text-slate-700 ring-slate-200",
            "staff_clinician" => "staff-clinician-badge",
            "staff_admin" => "bg-amber-50 text-amber-800 ring-amber-200",
            "senior_staff_admin" => "bg-teal-50 text-teal-800 ring-teal-200"
          }.fetch(staff_member.access_level, "bg-slate-100 text-slate-700 ring-slate-200") %>
          <li class="grid gap-3 py-4 text-medical-ink sm:grid-cols-3 sm:items-center sm:gap-4">
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-semibold"><%= staff_member.full_name %></span>
              <% unless staff_member.active? %>
                <span class="text-xs font-semibold text-red-700">Inactive</span>
              <% end %>
            </div>
            <div>
              <span class="mb-1 block text-xs text-medical-muted sm:hidden">Staff type</span>
              <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset <%= type_style %>">
                <%= staff_member.staff_type.humanize %>
              </span>
            </div>
            <div>
              <span class="mb-1 block text-xs text-medical-muted sm:hidden">Access level</span>
              <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset <%= access_style %>">
                <%= staff_member.access_level.humanize.titleize %>
              </span>
              <% if @current_staff_member.access_level.in?(%w[staff_admin senior_staff_admin]) %>
                <%= link_to "Edit details", edit_practice_staff_member_path(staff_member),
                  class: "mt-2 inline-flex rounded-lg border border-medical-border px-3 py-2 text-xs font-semibold text-medical-navy hover:bg-medical-teal-soft" %>
              <% end %>
              <% if !staff_member.active? &&
                    (@current_staff_member.access_level == "senior_staff_admin" ||
                     (@current_staff_member.access_level == "staff_admin" &&
                      !staff_member.access_level.in?(%w[staff_admin senior_staff_admin]))) %>
                <%= button_to "Reactivate", reactivate_practice_staff_member_path(staff_member), method: :patch,
                  class: "mt-2 rounded-lg border border-medical-border px-3 py-2 text-xs font-semibold text-medical-navy",
                  form: { data: { turbo_confirm: "Reactivate this staff member? Their practice access will be restored." } } %>
              <% end %>
              <% if staff_member.active? && @current_staff_member.id != staff_member.id &&
                    (@current_staff_member.access_level == "senior_staff_admin" ||
                     (@current_staff_member.access_level == "staff_admin" &&
                      !staff_member.access_level.in?(%w[staff_admin senior_staff_admin]))) %>
                <%= button_to "Deactivate", deactivate_practice_staff_member_path(staff_member), method: :patch,
                  class: "mt-2 rounded-lg border border-red-200 px-3 py-2 text-xs font-semibold text-red-700",
                  form: { data: { turbo_confirm: "Deactivate this staff member? Their access will be blocked." } } %>
              <% end %>
              <% if @current_staff_member.access_level == "senior_staff_admin" && staff_member.id != @current_staff_member.id %>
                <details class="group mt-2">
                  <summary class="inline-flex cursor-pointer list-none rounded-lg border border-medical-border px-3 py-2 text-xs font-semibold text-medical-navy hover:bg-medical-teal-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-medical-teal">
                    <span class="group-open:hidden">Edit access</span>
                    <span class="hidden group-open:inline">Cancel</span>
                  </summary>
                  <%= form_with url: access_level_practice_staff_member_path(staff_member), method: :patch,
                    scope: :staff_member, class: "mt-3 flex flex-wrap items-center gap-2" do |form| %>
                    <%= form.label :access_level, "Change access level", class: "sr-only" %>
                    <%= form.select :access_level,
                      StaffMember::ACCESS_LEVELS.reject { |level| level == "staff_clinician" && !staff_member.staff_type.in?(%w[doctor nurse]) }.map { |level| [ level.humanize.titleize, level ] },
                      { selected: staff_member.access_level },
                      class: "rounded-lg border border-medical-border bg-white px-3 py-2 text-sm text-medical-ink" %>
                    <%= form.submit "Save access level",
                      class: "rounded-full bg-medical-navy px-4 py-2 text-xs font-semibold text-white" %>
                  <% end %>
                </details>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-medical-muted">No staff members registered yet.</p>
    <% end %>
  </section>
</div>
