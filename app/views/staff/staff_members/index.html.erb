<% content_for :title, "Staff | Ballyclare Medical" %>

<div class="space-y-6">
  <header>
    <h1 class="text-4xl font-semibold text-medical-navy">Staff</h1>
    <p class="mt-2 text-medical-muted">People working at your practice.</p>
    <% if @current_staff_member.access_level.in?(%w[staff_admin senior_staff_admin]) %>
      <%= link_to "New staff member", new_practice_staff_member_path, class: "mt-4 inline-flex rounded-full bg-medical-navy px-6 py-3 text-sm font-semibold text-white" %>
    <% end %>
  </header>

  <section class="rounded-2xl border border-medical-border bg-white p-6">
    <% if @staff_members.any? %>
      <ul class="divide-y divide-medical-border">
        <% @staff_members.each do |staff_member| %>
          <li class="flex flex-wrap items-center gap-3 py-4 text-medical-ink">
            <span class="font-semibold"><%= staff_member.full_name %></span>
            <% type_style = {
              "doctor" => "bg-indigo-50 text-indigo-800 ring-indigo-200",
              "nurse" => "bg-emerald-50 text-emerald-800 ring-emerald-200",
              "administrator" => "bg-sky-50 text-sky-800 ring-sky-200"
            }.fetch(staff_member.staff_type, "bg-slate-50 text-slate-700 ring-slate-200") %>
            <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset <%= type_style %>">
              <%= staff_member.staff_type.humanize %>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-medical-muted">No staff members registered yet.</p>
    <% end %>
  </section>
</div>
