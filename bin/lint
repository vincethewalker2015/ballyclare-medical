#!/usr/bin/env ruby

require "bundler/setup"

fix = ARGV.delete("--fix") || ARGV.delete("-a")
unless ARGV.empty?
  warn "Usage: bin/lint [--fix]"
  exit 2
end

def run_check(label, *command)
  puts "\n#{label}"
  system(*command)
end

if fix
  puts "Auto-correcting Ruby and ERB templates..."
  corrected = run_check("RuboCop autocorrect", "bin/rubocop", "-a")
  corrected = run_check("ERB Lint autocorrect", "bundle", "exec", "erb_lint", "-a", "--lint-all") && corrected
  unless corrected
    warn "\nAuto-correction reported errors. Review the output above."
    exit 1
  end
end

puts "Running Ruby, ERB, and security checks..."
results = [
  run_check("RuboCop", "bin/rubocop"),
  run_check("ERB Lint", "bundle", "exec", "erb_lint", "--lint-all"),
  run_check("Brakeman", "bin/brakeman", "--no-pager")
]

if results.all?
  puts "\nAll linting checks passed."
  exit 0
else
  warn "\nOne or more linting checks failed."
  exit 1
end
